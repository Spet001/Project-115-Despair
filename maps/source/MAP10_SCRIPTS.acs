#include"Zcommon.acs"

script 998 ENTER
{//HEALTH REGENERATION
    int health = GetActorProperty(1337, APROP_Health);

    While(True)
    {
        {
            //Constantly work while health is under 100
            While(GetActorProperty(1337,APROP_Health)<100 && GetActorProperty(1337,APROP_Health)>=1)
            {
                //After each hit you take, wait for regeneration
                If(GetActorProperty(1337,APROP_Health)<health)
                {
                HudMessage(s:"";HUDMSG_FADEOUT, 101, CR_RED, 240.0, 180.0, 0.1, 0.1);
                }
                health = GetActorProperty(1337, APROP_Health);
                SetActorProperty(1337, APROP_Health, health + 1);
                Delay(3);
            }
        }
    Delay(1);
    }
}

script 997 ENTER
{//Indicate critial health level
    While(True)
	{
            //Constantly work while health is under 30
            if(GetActorProperty(1337,APROP_Health)<40 && GetActorProperty(1337,APROP_Health)>=1)
                {
                HudMessage(s:"Critical Health Level!";HUDMSG_FADEOUT, 1, CR_RED, 3.0, 0.2, 0.5);
            }
			 Delay(1);

        }
	}
	
script 996 ENTER
{//Critical Health Sound
    While(True)
	{
            //Constantly work while health is under 30
            if(GetActorProperty(1337,APROP_Health)<40 && GetActorProperty(1337,APROP_Health)>=1)
                {
				ThingSound(1337, "sound/HLTHCRIT", 127);
            }
			 Delay(6);

        }
	}
		

script 995 death

{

If(GetActorProperty(1337,APROP_Health)<=0)

    {
    TakeInventory("HUD_ON", 1);
setmusic("ZM_DEATH", 0, 0);
AmbientSound("sound/SUITDIE", 127);
fadeto(0, 0, 0, 1.0, 6.9);
DELAY(380);
setmusic("BOTKIL8", 0, 0);
}
}

Script 1 ENTER
{
	Thing_ChangeTID (0, 1337+PlayerNumber());
	SpawnSpotForced("TheSource", 1, 42, 192);
	delay(1);
	Thing_Deactivate(2);
}

Script 2 ENTER
{
	ChangeSky("CMP_AGAR", "CMP_AGAR");
	setmusic("PREBOSS", 0, 0);
	SetActorProperty(42, APROP_Health, 50000);
	SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
	Teleport(1337, 1, 1);
	Thing_Move(1337, 42, 0);
	delay(80);
	hudmessage(s:"[The Source]\n\cjOut of every single living human on Earth, only one has managed to make it to me?";
	HUDMSG_FADEINOUT, 1, CR_RED, 3.0, 0.7, 6.0);
	AmbientSound("quote/C3M2Q1", 127);
	delay(280);
	hudmessage(s:"[The Source]\n\cjYou...a scavenger";
	HUDMSG_FADEINOUT, 1, CR_RED, 3.0, 0.7, 3.0);
	AmbientSound("quote/C3M2Q2", 127);
	delay(140);
	hudmessage(s:"[Jason]\n\cjI made it this far. I can’t stop now. You will not stop me.";
	HUDMSG_FADEINOUT, 1, CR_GREEN, 3.0, 0.7, 4.0);
	AmbientSound("quote/C3M2Q3", 127);
	delay(160);
	hudmessage(s:"[The Source]\n\cjAnd what do you plan to do after defeating me?";
	HUDMSG_FADEINOUT, 1, CR_RED, 3.0, 0.7, 4.0);
	AmbientSound("quote/C3M2Q4", 127);
	delay(150);
	hudmessage(s:"[Jason]\n\cjTo continue living in the mess you left behind.";
	HUDMSG_FADEINOUT, 1, CR_GREEN, 3.0, 0.7, 4.0);
	AmbientSound("quote/C3M2Q5", 127);
	delay(160);
	hudmessage(s:"[The Source]\n\cjOh Jason...Do you have..What it takes?";
	HUDMSG_FADEINOUT, 1, CR_RED, 3.0, 0.7, 4.0);
	AmbientSound("quote/C3M2Q6", 127);
	delay(200);
	hudmessage(s:"[Jason]\n\cjIf you want me dead so badly...come and get it.";
	HUDMSG_FADEINOUT, 1, CR_GREEN, 3.0, 0.7, 4.0);
	AmbientSound("quote/C3M2Q7", 127);
	delay(140);
	Autosave();
	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
	ACS_Execute(3,0,0,0,0);
	ACS_Execute(4,0,0,0,0);
	ACS_Execute(5,0,0,0,0);
	ACS_Execute(6,0,0,0,0);
	ACS_Execute(7,0,0,0,0);
	ACS_Execute(8,0,0,0,0);
	ACS_Execute(9,0,0,0,0);
	ACS_Execute(70,0,0,0,0);
	ACS_Execute(71,0,0,0,0);
	ACS_Execute(82,0,0,0,0);
	setmusic("FNLBOSS", 0, 0);
	GiveInventory("HUD_ON", 1);
}

script 70 (void)

{
	HudMessage(s:"The Source";
	HUDMSG_PLAIN, 401, CR_ORANGE, 3.0, 0.14, 1.0);
	HudMessage(d: GetActorProperty(42, APROP_Health);
	HUDMSG_PLAIN, 400, CR_DARKRED, 3.0, 0.19, 1.0);
	delay(1);
	Restart;
}

script 71 (void)
{
	While(True)
	{
		If(GetActorProperty(42, APROP_Health) <= 0)
		{
			Thing_Move(1337, 26, 1);
			SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
			delay(1);
				HudMessage(s:"";
	HUDMSG_PLAIN, 401, CR_ORANGE, 3.0, 0.14, 1.0);
	HudMessage(s:"";
	HUDMSG_PLAIN, 400, CR_DARKRED, 3.0, 0.19, 1.0);
			ClearInventory();
			ACS_Terminate(3, 0);
			ACS_Terminate(4, 0);
			ACS_Terminate(5, 0);
			ACS_Terminate(6, 0);
			ACS_Terminate(7, 0);
			ACS_Terminate(8, 0);
			ACS_Terminate(9, 0);
			ACS_Terminate(70, 0);
			ACS_Execute(72,0,0,0,0);
		}
		Delay(1);
	}
}
