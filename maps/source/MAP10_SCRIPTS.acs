//Spawn in the zombies! KEEPT THEM AT IT LIMIT!
script 3 (void)
{
	While(True)
	{
		If(ThingCountName("CP_SprintingZombie1", 101) < 3)
		{
	Delay(40);
	SpawnSpotFacingForced("CP_SprintingZombie1", Random(22, 25), 101);
		}
	If(ThingCountName("CP_SprintingZombie1", 101) == 3)
	{
		print(s:"");
	}
		Delay(1);
	}
}

