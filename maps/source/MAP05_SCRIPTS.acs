	AmbientSound("quote/C1M4Q2", 127);
}

script 11 (void)

{
	HudMessage(s:"Inferno Seeker";
	HUDMSG_PLAIN, 998, CR_ORANGE, 3.0, 0.14, 1.0);
	HudMessage(d: GetActorProperty(100, APROP_Health);
	HUDMSG_PLAIN, 999, CR_DARKRED, 3.0, 0.19, 1.0);
	Thing_Hate(1337, 100, 0);
	delay(1);
	Restart;
}

script 12 (void)
{
	While(True)
	{
		If(GetActorProperty(100, APROP_Health) <= 0)
		{
			ACS_Execute(13,0,0,0,0);
			ACS_Terminate(11,0);
			ACS_Terminate(61,0);
		}
		Delay(1);
	}
}

script 61 (void)
{
	While(True)
	{
		If(ThingCountName("CP_FastZombie1", 101) == 0 && ThingCountName("CP_FastZombie2", 101) == 0)
		{
	Delay(40);
	SpawnSpotFacingForced("CP_FastZombie1", 58, 101);
	delay(40);
	SpawnSpotFacingForced("CP_FastZombie2", 58, 101);
		}
	If(ThingCountName("CP_FastZombie1", 101) == 5 && ThingCountName("CP_FastZombie2", 101) == 5)
	{
		print(s:"");
	}
		Delay(1);
	}
}


