Script 9 (void)
{
	if(NecklacePlace == True)
	{
		Print(s:"");
	}
	else if(ThingCountName("EliteScavenger", 75) > 0 && ThingCountName("ShotGunScavenger", 75) > 0)
{
Print(s:"Now is not the time..");
	}
else if(ThingCountName("EliteScavenger", 75) == 0 && ThingCountName("ShotGunScavenger", 75) == 0)
	{
		NecklacePlace = True;
	Thing_Remove(74);
	SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
	SetActorAngle(1337, 0.25);
	SetActorPitch(1337, 0);
	SpawnSpotForced("Gateway_Necklace_Portal_Prop", 50, 0, 0);
	ThingSound(50, "craft/part", 127);
	delay(30);
	fadeto(255,255,255, 1.0, 0.1);
	SetLineTexture(49, SIDE_FRONT, TEXTURE_MIDDLE, "FIREBLU1");
	SetLineTexture(49, SIDE_BACK, TEXTURE_MIDDLE, "FIREBLU1");
	AmbientSound("sound/GEMPLACE", 127);
	delay(13);
	fadeto(0,0,0, 0.0, 5.0);
	delay(100);
	AmbientSound("sound/INCOMING", 127);
	delay(25);
	AmbientSound("sound/INCOMING", 127);
	delay(25);
	fadeto(255,255,255, 1.0, 0.1);
	SetLineTexture(49, SIDE_FRONT, TEXTURE_MIDDLE, "-");
	SetLineTexture(49, SIDE_BACK, TEXTURE_MIDDLE, "-");
	SpawnSpotFacingForced("CP_InfernoSeeker", 58, 100);
	Thing_Deactivate(100);
	AmbientSound("sound/INCOMING", 127);
	AmbientSound("inferno/yell", 127);
	delay(25);
		fadeto(0,0,0, 0.0, 5.0);
	AmbientSound("sound/INCOMING", 127);
	delay(100);
	hudmessage(s:"[Jason]\n\cjOut of the portal to Ogrodolan..came the Inferno Seeker.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q7", 127);
	delay(135);
	SetMusic("BOSS1MUS");
	Thing_Activate(100);
	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
	Thing_Activate(44);
	SetActorFlag(44, "AVOIDMELEE", TRUE);
	SetActorFlag(44, "INVULNERABLE", TRUE);
	SetActorFlag(44, "SHOOTABLE", FALSE);
	Thing_SetGoal(44, 65, 0, 1);
	SetActorProperty(44, APROP_Invulnerable, ON);
	SetActorProperty(100, APROP_HEALTH, 10000);
	ACS_Execute(11,0,0,0,0);
	ACS_Execute(12,0,0,0,0);
	ACS_Execute(61,0,0,0,0);
}
}


script 10 (void)
{
