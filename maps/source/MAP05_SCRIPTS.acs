}
}

Script 1 Enter
{
		SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.25);
	Elevator_LowerToNearest(6, 20);
	Delay(3);
		hudmessage(s:"[Jason]\n\cjThe final floor underground. Further ahead, the Red Division knew we were coming.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q1", 127);
	delay(170);
	Door_Open(5, 32, 0);
	delay(3);
	Thing_SetGoal(44, 45, 0, 0);
}

Script 2 (void)//The player falls through the false floor
{
	Floor_LowerByValue(25, 53, 174);
	Ceiling_LowerByValue(25, 53, 174);
	delay(20);
	hudmessage(s:"[Jason]\n\cjThe left side may have been a bad idea. A broken floor. Good thing it was not a trap.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q3", 127);
}

int DoorOpen = 0;
script 3 (void)//Let the player choose which door to OPEN
{
	if (DoorOpen == 1)
	{
		print(s:"");
	}
	else if (DoorOpen == 0)
	{
	Thing_Remove(38);
	Door_Open(37, 35, 0);
	DoorOpen ++;
}
}

script 4 (void)
{
	if (DoorOpen == 1)
	{
		print(s:"");
	}
	else if (DoorOpen == 0)
	{
	Thing_Remove(38);
	Door_Open(39, 35, 0);
	DoorOpen ++;
}
}

Script 5 (void)
{
	SetMusic("Action4");
			hudmessage(s:"[Jason]\n\cjNothing upon entering the room to the right. Only to know that a door was locked.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q4", 127);
}

Script 6 (void)//Last door if the player goes left
{
	Door_Open(40,35,0);
	Thing_Remove(41);
	Thing_Remove(43);
	SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
	SetActorAngle(1337, 1.0);
	SetActorPitch(1337, 0);
	Thing_Move(1337, 42, 1);
	Thing_Move(44, 51, 1);
	SetActorAngle(44, 0.5);
	delay(20);
	hudmessage(s:"[Jason]\n\cjWe both found each other. We continued on.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q5", 127);
	delay(14);
	Thing_SetGoal(44, 61, 0, 0);
	Thing_Activate(44);
	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
        delay(135);
	hudmessage(s:"[Jason]\n\cjThat big thing I mentioned was only moments ahead.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q6", 127);
}

Script 7 (void)//Last door if the player goes right
{
	If(CheckInventory("YellowCard") == 1)
	{
		TakeInventory("YellowCard", 999);
	Door_Open(53,35,0);
	Thing_Remove(54);
	Thing_Remove(55);
	SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
	SetActorAngle(1337, 0.25);
	SetActorPitch(1337, 0);
	Thing_Move(1337, 56, 1);
	Thing_Move(44, 57, 1);
	SetActorAngle(44, 0.75);
	delay(20);
	hudmessage(s:"[Jason]\n\cjWe both found each other. We continued on.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q5", 127);
	delay(14);
	Thing_Activate(44);
	Thing_SetGoal(44, 61, 0, 0);
	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
        delay(135);
	hudmessage(s:"[Jason]\n\cjThat big thing I mentioned was only moments ahead.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q6", 127);
}
}

