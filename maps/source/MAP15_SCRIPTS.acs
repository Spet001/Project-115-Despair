Script 334 (void)
{
While (true)
{
	If (ThingCountName("SlowZombie1", 102) == 0 && ThingCountName("SlowZombie2", 102) == 0 && 
	ThingCountName("NormalZombie1", 102) == 0 && ThingCountName("NormalZombie2", 102) == 0 && 
	ThingCountName("FastZombie1", 102) == 0 && ThingCountName("FastZombie2", 102) == 0 && 
	ThingCountName("SprintingZombie1", 102) == 0 && ThingCountName("SprintingZombie2", 102) == 0)
	{
		RoundActive = FALSE;
		AmbientSound("SOUND/NACHT_EN", 127);
		ACS_Terminate(301,0);
		ACS_Execute(804,0,0,0,0);
		ACS_Execute(805,0,0,0,0);
		ACS_Execute(806,0,0,0,0);
		ACS_Execute(807,0,0,0,0);
		Delay(300);
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
	    ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ACS_Execute(333,0,0,0,0);
		ACS_Execute(301,0,0,0,0);
		Break;
		}
	Delay(1);
}
}


script 302 enter//DISPLAY SOUND NUMBER
{
      SetFont("BIGFONT");
              HUDMessage(d:RoundNumber;
              HUDMSG_PLAIN, 99, CR_Red, 0.11, 0.94, 0);
			Delay(1);
			  RESTART;
}

Script 301 (void)
{

	SetActorProperty(100, APROP_Health, ZHealth);
	Thing_ChangeTID(100, 102);
	delay(59);
	restart;
}

Script 300 (void)

{
Thing_Destroy(102, 99999999, 0);
}

//PREVENT THE PLAYER FROM RESPAWNING AFTER THEY DIED
bool Player1_Dead;
bool Player2_Dead;
bool Player3_Dead;
bool Player4_Dead;
//Score Board Ints//
int Player1_Kills = 0;
int Player2_Kills = 0;
int Player3_Kills = 0;
int Player4_Kills = 0;
int Player1_Points = 500;
int Player2_Points = 500;
int Player3_Points = 500;
int Player4_Points = 500;
int Player1_Deaths = 0;
int Player2_Deaths = 0;
int Player3_Deaths = 0;
int Player4_Deaths = 0;

Script 800 DEATH
{
	ClearInventory();
	delay(10);
	ACS_Execute(803,0,0,0,0);
}

//Move the player in a black box//
script 801 respawn
{
	If (RoundActive == True && PlayerNumber()==0)
	{
		Player1_Deaths ++;
		Thing_ChangeTid(1337,0);
		Thing_ChangeTid(0,1337);
		ClearInventory();
		delay(1);
		Thing_Move(1337,400,1);
		Player1_Dead = TRUE;
	}
	else If (RoundActive == True && PlayerNumber()==1)
	{
		Player2_Deaths ++;
		Thing_ChangeTid(1338,0);
		Thing_ChangeTid(0,1338);
		ClearInventory();
		delay(1);
		Thing_Move(1338,401,1);
		Player2_Dead = TRUE;
	}
	else If (RoundActive == True && PlayerNumber()==2)
	{
		Player3_Deaths ++;
		Thing_ChangeTid(1339,0);
		Thing_ChangeTid(0,1339);
		ClearInventory();
		delay(1);
		Thing_Move(1339,402,1);
		Player3_Dead = TRUE;
	}
	else If (RoundActive == True && PlayerNumber()==3)
	{
		Player4_Deaths ++;
		Thing_ChangeTid(1340,0);
		Thing_ChangeTid(0,1340);
		ClearInventory();
		delay(1);
		Thing_Move(1340,403,1);
		Player4_Dead = TRUE;
	}
}

//Put the player back into the game!//
script 804 (void)
{
	If(Player1_Dead == True)
	{
	Thing_Move(1337,404,1);
	//Reset inventory
	delay(1);
	GiveActorInventory(1337,"ColtM1911", 255);
	GiveActorInventory(1337,"MaxWeapons", 1);
	GiveActorInventory(1337,"ColtM1911ammo", 255);
	GiveActorInventory(1337,"Knife", 255);
	GiveActorInventory(1337,"FragGrenade", 255);
	GiveActorInventory(1337,"money", 1500);
	//Reset speed and jump height
	SetActorProperty(1337, APROP_Speed, 0.67);
	Player1_Dead = FALSE;
	}
}

