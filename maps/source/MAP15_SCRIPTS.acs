script 807 (void)
{
	If(Player4_Dead == True)
	{
	Thing_Move(1340,407,1);
	//Reset inventory
	delay(1);
	GiveActorInventory(1340,"ColtM1911", 255);
	GiveActorInventory(1340,"MaxWeapons", 1);
	GiveActorInventory(1340,"ColtM1911ammo", 255);
	GiveActorInventory(1340,"Knife", 255);
	GiveActorInventory(1340,"FragGrenade", 255);
	GiveActorInventory(1340,"money", 1500);
	//Reset speed and jump height
	SetActorProperty(1340, APROP_Speed, 0.67);
	Player4_Dead = FALSE;
	}
}

script 803 (void)

