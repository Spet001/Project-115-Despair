Script 410 (void)
{
 HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu To Enter This Area\n\ck[cost:1000]";
HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
}

Script 411 (void)
{
	
    if(GetSectorFloorZ(3,0,0)==80.0)
    {
        if(ActivatorTID()==1337 && checkactorinventory(1337,"money") >= 1000)
        {
			ACS_Execute(Random(710, 740), 0,0,0,0);
            Floor_LowerToNearest(3,30);
			Thing_Move(93, 7, 1);
            takeACTORinventory(1337,"money", 1000);
            setlineblocking(1, BLOCK_NOTHING);
        }
        else if(ActivatorTID()==1338 && checkactorinventory(1338,"money") >= 1000)
        {
			ACS_Execute(Random(710, 740), 0,0,0,0);
            Floor_LowerToNearest(3,30);
			Thing_Move(93, 7, 1);
            takeACTORinventory(1338,"money", 1000);
            setlineblocking(1, BLOCK_NOTHING);
                    }
        else if(ActivatorTID()==1339 && checkactorinventory(1339,"money") >= 1000)
        {
			ACS_Execute(Random(710, 740), 0,0,0,0);
            Floor_LowerToNearest(3,30);
			Thing_Move(93, 7, 1);
            takeACTORinventory(1339,"money", 1000);
            setlineblocking(1, BLOCK_NOTHING);
        }
        else if(ActivatorTID()==1340 && checkactorinventory(1340,"money") >= 1000)
        {
			ACS_Execute(Random(710, 740), 0,0,0,0);
            Floor_LowerToNearest(3,30);
			Thing_Move(93, 7, 1);
            takeACTORinventory(1340,"money", 1000);
            setlineblocking(1, BLOCK_NOTHING);
        }

    }
}


