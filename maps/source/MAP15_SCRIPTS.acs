script 418 enter
{
	if(GetSectorFloorZ(5,0,0)==0)
	{
		setlineblocking(1, BLOCK_NOTHING);
		setlineblocking(3, BLOCK_NOTHING);
	}
	delay(1);
	restart;
}

int DeathMachine_Time_Player1 = 30;
int DeathMachine_Time_Player2 = 30;
int DeathMachine_Time_Player3 = 30;
int DeathMachine_Time_Player4 = 30;
//Death Machine//

Script 303 (void)
{
	if(ActivatorTID()==1337)
	{
	ACS_Execute(304,0,0,0,0);
	}
	else if(ActivatorTID()==1338)
	{
	ACS_Execute(305,0,0,0,0);
	}
	else if(ActivatorTID()==1339)
	{
	ACS_Execute(306,0,0,0,0);
	}
	else if(ActivatorTID()==1340)
	{
	ACS_Execute(307,0,0,0,0);
	}
}

Script 304 (void)//Player 1
{
	While(TRUE)
	{
		If(DeathMachine_Time_Player1 == 0)
		{
			TakeActorInventory(1337, "DeathMachine", 9999);
			DeathMachine_Time_Player1 = 30;
			delay(1);
			Terminate;
		}
		Else If (DeathMachine_Time_Player1 > 0)
		{
			HUDMessage(s:"\cuDeath Machine: ", d: DeathMachine_Time_Player1;
			HUDMSG_FADEOUT, 7, CR_Gold, 3.0, 0.80, 2.0);
			DeathMachine_Time_Player1 --;
		}
	Delay(35);
	}
}

