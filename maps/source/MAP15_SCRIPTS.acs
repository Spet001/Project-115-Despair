#include "zcommon.acs"
Script 999 ENTER
{
		for(int j=0; j<=999; j++)
        Sector_SetColor(j,255,255,255,150);
	FadeTo(0,0,0,1.0,0);
	  //Set up player IDs
    Thing_ChangeTID (0, 1337+PlayerNumber());
	GiveInventory("MaxWeapons", 1);
	delay(1);
	setlineblocking(1, BLOCK_PLAYERS);
	setlineblocking(1, BLOCK_CREATURES);
	setlineblocking(2, BLOCK_PLAYERS);
	setlineblocking(3, BLOCK_PLAYERS);
	setlineblocking(3, BLOCK_CREATURES);
	setlineblocking(4, BLOCK_PLAYERS);
	setlineblocking(5, BLOCK_PLAYERS);
	setlineblocking(6, BLOCK_PLAYERS);
	setlineblocking(7, BLOCK_CREATURES);
	setlineblocking(9, BLOCK_CREATURES);
	setlineblocking(105, BLOCK_CREATURES);
	ChangeSky("ZM_PARKS", "ZM_PARKS");
	SetMusic("", 0);
	GiveInventory("Money", 500);
	GiveInventory("ColtM1911", 999);
	GiveInventory("Knife", 999);
	GiveInventory("FragGrenade", 999);
	GiveInventory("HUD_ON", 1);
	TakeInventory("Pistol", 999);
	TakeInventory("Fist", 999);
	TakeInventory("Cursor", 999);
	delay(50);
	FadeTo(0,0,0,0,1.5);
	SetMusic("ZM_NACHT", 0);
Delay(100);
ACS_Execute(334,0,0,0,0);
	hudmessage(s:"Ramstein Air Base\nLocation: Ramstein-Miesenbach, Germany\nDate: October 26, 2017";
	HUDMSG_TYPEON, 0, CR_GREEN, 2, 0.8, 7.0);
}

//Player 1 Money/Dead
    script 998 ENTER
    
    {
        if(PlayerNumber()==0)
        {
                HudMessageBold(n:1, s:" $", d: CheckactorInventory(1337, "money");
                           HUDMSG_PLAIN, 999, CR_WHITE, 0.0, -0.60, 1.0);
                           {
                        delay(1);
                        {
                        restart;
                        }
                        }
        }
        }
    //Player 2 Money/Dead
            script 997 ENTER
            {
              if(PlayerNumber()==1)
        {
                HudMessageBold(n:2, s:" $", d: CheckActorInventory(1338, "money");
                           HUDMSG_PLAIN, 998, CR_lightblue, 0.0, -0.64, 1.0);
                           {
                        delay(1);
                        {
                        restart;
                        }
                        }
        }
        }
          //Player 3 Money/Dead
        script 996 ENTER
            {
              if(PlayerNumber()==2)
        {
                HudMessageBold(n:3, s:" $", d: CheckActorInventory(1339, "money");
                           HUDMSG_PLAIN, 997, CR_yellow, 0., -0.68, 1.0);
                           {
                        delay(1);
                        {
                        restart;
                        }
                        }
        }
        }
        
  //Player 4 Money/Dead
        script 995 ENTER
            {
              if(PlayerNumber()==3)
        {
                HudMessageBold(n:4, s:" $", d: CheckActorInventory(1340, "money");
                           HUDMSG_PLAIN, 996, CR_Green, 0., -0.72, 1.0);
                           {
                        delay(1);
                        {
                        restart;
                        }
                        }
        }
        }
		


