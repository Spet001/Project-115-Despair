Script 334 (void)
{
While (true)
{
	If (ThingCountName("ARC_SprintingZombie1", 102) == 0 && ThingCountName("ARC_SprintingZombie2", 102) == 0 )
	{
		RoundActive = FALSE;
		if (RoundNumber == 29)
		{
		SetMusic("");
	delay(100);
	Floor_LowerToLowest(36, 20);
	SetMusic("BOSSMUS");
	delay(200);
				SetFont("BigFont");
		HudMessageBold(s:"The Boss Is Waking!";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.25, 6.0);
				SetFont("SmallFont");
			HudMessageBold(s:"Prepare To Fight";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.30, 6.0);
		delay(400);
		Thing_Activate(45);
		SetActorProperty(45, APROP_HEALTH, 900000);
				SetFont("BigFont");
		HudMessageBold(s:"Fight!";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.3, 6.0);
		GiveActorInventory(1337, "HealthBonus", 100);
		GiveActorInventory(1338, "HealthBonus", 100);
		GiveActorInventory(1339, "HealthBonus", 100);
		GiveActorInventory(1340, "HealthBonus", 100);
		GiveActorInventory(1337, "MysticOrb", 2);
		GiveActorInventory(1338, "MysticOrb", 2);
		GiveActorInventory(1339, "MysticOrb", 2);
		GiveActorInventory(1340, "MysticOrb", 2);
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ACS_Execute(333,0,0,0,0);
		ACS_Execute(301,0,0,0,0);
		Break;
			}
		else if (RoundNumber == 0)
		{
			SetFont("BigFont");
		HudMessageBold(s:"The Hoard Is Coming!";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.30, 6.0);
		ACS_Terminate(301,0);
		Delay(400);
		SetFont("BigFont");
		HudMessageBold(s:"Fight!";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.3, 6.0);
		GiveActorInventory(1337, "HealthBonus", 100);
		GiveActorInventory(1338, "HealthBonus", 100);
		GiveActorInventory(1339, "HealthBonus", 100);
		GiveActorInventory(1340, "HealthBonus", 100);
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ACS_Execute(333,0,0,0,0);
		ACS_Execute(301,0,0,0,0);
		Break;
			}
			else if (RoundNumber > 0)
			{
		SetFont("BigFont");
		HudMessageBold(s:"Round ", d:RoundNumber, s:" Complete";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.25, 6.0);
		SetFont("SmallFont");
			HudMessageBold(s:"Prepare To Fight";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.30, 6.0);
		ACS_Terminate(301,0);
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		ZHealth ++;
		Delay(400);
		SetFont("BigFont");
		HudMessageBold(s:"Fight!";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.3, 6.0);
		GiveActorInventory(1337, "HealthBonus", 100);
		GiveActorInventory(1338, "HealthBonus", 100);
		GiveActorInventory(1339, "HealthBonus", 100);
		GiveActorInventory(1340, "HealthBonus", 100);
		ACS_Execute(333,0,0,0,0);
		ACS_Execute(301,0,0,0,0);
		Break;
		}
}
Delay(1);
}
}

Script 301 (void)
{

	SetActorProperty(100, APROP_Health, ZHealth);
	delay(1);
	Thing_ChangeTID(100, 102);
	delay(29);
	restart;
}


