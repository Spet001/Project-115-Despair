 script 994 enter
 {
	SpawnSpotForced("Chash1", random(29, 35), 0, 0);
	SpawnSpotForced("Chash3", random(29, 35), 0, 0);
       delay(random(30, 1000));
	   		SpawnSpotForced("Chash2", random(29, 35), 0, 0);
			   SpawnSpotForced("Chash4", random(29, 35), 0, 0);
       delay(random(30, 1000));
	   		SpawnSpotForced("Chash3", random(29, 35), 0, 0);
			   SpawnSpotForced("Chash2", random(29, 35), 0, 0);
       delay(random(30, 1000));
	   		SpawnSpotForced("Chash4", random(29, 35), 0, 0);
			   SpawnSpotForced("Chash1", random(29, 35), 0, 0);
       delay(random(30, 1000));
	   restart;
     }


Script 81 (void)//KILLING THE BOSS//
{
		SetplayerProperty(1, ON, PROP_TOTALLYFROZEN);
		delay(100);
	SetMusic("ARC_GO");
	SetFont("BigFont");
		HudMessageBold(s:"The Inferno Seeker Has Been Defeated!";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.25, 6.0);
				SetFont("SmallFont");
			HudMessageBold(s:"Your Journey Ends Here On Apacolypse Island";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.30, 6.0);
		delay(200);
		FadeTo(0,0,0,1.0, 4.0);
		delay(200);
		SetplayerProperty(1, OFF, PROP_TOTALLYFROZEN);
		delay(3);
		ChangeLevel("Map01", 0, CHANGELEVEL_NOINTERMISSION, -1);
}

Script 82 enter

{
 int buttons;

 while (TRUE)
 {
   buttons = GetPlayerInput(-1, INPUT_BUTTONS);

   if (buttons & BT_JUMP && CheckInventory("MysticOrb") >= 10)
   {
     Thing_Destroy(102, 99999999999999, 0);
	 TakeInventory("MysticOrb", 10);
	 delay(200);
   }
   else if (buttons & BT_JUMP && CheckInventory("MysticOrb") < 10)
{
	Print(s:"Not Enough Mystic Orbs");
   }
   delay(1);
 }
}

Script 83 enter

{
HudMessageBold(k:"+altattack", s:"\cj: \crShotgun Upgrade \cj[Cost: 5 Mystic Orbs]";
HUDMSG_PLAIN, 0, CR_ORANGE, 0, 0.90, 0);
HudMessageBold(k:"+jump", s:"\cj: \crNuke \cj[Cost: 10 Mystic Orbs]";
HUDMSG_PLAIN, 0, CR_ORANGE, 0, 0.85, 0);
}

int Player_Dead;
Script 87 DEATH
{
	Player_Dead ++;
	delay(1);
	if(Player_Dead == 4);
	{
		SetMusic("ARC_GO");
		SetFont("BigFont");
		HudMessageBold(s:"Game Over\nYou Survived Until Round ", d:RoundNumber, s:"!";
		HUDMSG_FADEINOUT, 0, CR_RED, 3.0, 0.25, 6.0);
		delay(200);
		FadeTo(0,0,0,1.0, 4.0);
		delay(200);
		ChangeLevel("Map01", 0, CHANGELEVEL_NOINTERMISSION, -1);
	}
}