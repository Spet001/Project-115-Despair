script 123 ENTER
{
	Thing_Deactivate(45);
	RoundActive = FALSE;
	Thing_ChangeTID (0, 1337+PlayerNumber());
	TakeInventory("Cursor", 999);
	GiveInventory("Arcade_Main_Weapon", 999);
	TakeInventory("Pistol", 999);
	TakeInventory("Fist", 999);
	delay(1);
	Thing_Move(1337, 46, 1);
	Thing_Move(1338, 47, 1);
	Thing_Move(1339, 48, 1);
	Thing_Move(1340, 49, 1);
	SetWeapon("Arcade_Main_Weapon");
	SetMusic("Mus_Arca", 0);
	delay(60);
ACS_Execute(334,0,0,0,0);
}

#define C_TID		1000	//Default camera tid
#define MAX_R		128	//Maximum radius (or distance from the player)
#define ADJUST_R	-40	//Amount to adjust the camera by
#define VIEW_HEIGHT	200.0	//The approximate height of the player's view

bool cam_mode[8];		//Variable for turning the camera on or off.
	
Script 1 ENTER
{
	cam_mode[PlayerNumber ()] = ON;
	ACS_ExecuteAlways (3, 0, PlayerNumber ());
}

Script 2 RESPAWN
{
	cam_mode[PlayerNumber ()] = ON;
	ACS_ExecuteAlways (3, 0, PlayerNumber ());
}

Script 3 (int p_num)
{
	int r = MAX_R;
	
	while (cam_mode[p_num] == ON)
	{	
		int a = GetActorAngle (0);
		int p = 14000;
		int x = GetActorX (0);
		int y = GetActorY (0);
		int z = 400 + VIEW_HEIGHT;
		int xyr = r * cos (p) >> 16;
		
		if (!ThingCountName ("ChaseCam", C_TID+p_num))
		{
			while (!Spawn ("ChaseCam", x-cos(a)*xyr, y-sin(a)*xyr, z+sin(p)*r, C_TID+p_num, a >> 8) && r > 0)
			{
				r -= ADJUST_R;
				xyr = cos (p) * r >> 16;
			}
			
			if (ThingCountName ("ChaseCam", C_TID + p_num))
				ChangeCamera (C_TID + p_num, 0, 0);
			else
			{
				cam_mode[p_num] = OFF;
				print (s:"Camera script failed to initialize.");
			}
		}

	        else
		{
			while (!SetActorPosition (C_TID+p_num, x-cos(a)*xyr, y-sin(a)*xyr, z+sin(p)*r, 0) && r > 0)
			{
				r -= ADJUST_R;
				xyr = cos (p) * r >> 16;
			}
			
			SetActorAngle (C_TID + p_num, a);
			SetActorPitch (C_TID + p_num, p);
			
			if (r < MAX_R) 
                              r += ADJUST_R;
		}
		
		delay (1);
	}
}


Script 4 DEATH
{
	cam_mode[PlayerNumber ()] = on;
	Thing_Remove (C_TID + PlayerNumber ());
}

Script 5 (int p_num) DISCONNECT
{
       cam_mode[p_num] = OFF;
       Thing_Remove (C_TID + p_num);
}

script 6 ENTER
{
	SetActorPitch(1337, 0);
	SetActorPitch(1338, 0);
	SetActorPitch(1339, 0);
	SetActorPitch(1340, 0);
	delay(1);
	restart;
}

