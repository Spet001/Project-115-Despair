Script 12 (void)
{
	Acs_Terminate(8,0);
	hudmessageBold(s:"[Jason]\n\cjI couldn't risk firing and missing. Either way, he knew I was there.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C3M1Q8", 127);
	delay(170);
	SetActorState(52, "TALKING", TRUE);
	hudmessageBold(s:"[Jason]\n\cjDanny was surprised to see I survived. Even made me into a fool that I placed the necklace. All hell will break loose.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 7.0);
	AmbientSound("quote/C3M1Q9", 127);
	delay(280);
	hudmessageBold(s:"[Jason]\n\cjA brief silence...";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C3M1Q10", 127);
	delay(90);
	SetActorState(52, "NOTALK", TRUE);
	SetActorState(52, "RaiseWeapon", TRUE);
	delay(71);
	GiveInventory("CP_AmmoFireTrue", 1);//Gonna have to make a different actor where it fires instantly
	delay(1);
	Thing_Activate(52);
	Thing_Damage(52, 500, MOD_EXIT);
	delay(201);
	hudmessageBold(s:"[Savion]\n\cjSo the Void Sword was now yours?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C3M1Q11", 127);
	delay(160);
	//Move Forward
	ACS_Execute(21,0,0,0,0);
	TakeInventory("CP_sightsColtM1911", 999);
	TakeInventory("CP_sightsP226", 999);
	TakeInventory("CP_sightsRagingBull", 999);
	TakeInventory("CP_sightsGlock20", 999);
	hudmessageBold(s:"[Jason]\n\cjIndeed it was. Now..to fight The Source.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C3M1Q12", 127);
	delay(70);
	SetPlayerProperty(1,0,PROP_TOTALLYFROZEN);
	AmbientSound("sound/REAMMO", 90);
	ACS_Terminate(11,0);
	SetWeapon("VoidSword");
}

script 13 (void)
{
		If(CheckInventory("VoidSword") == 1)
	{
		SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
			AmbientSound("sound/TELEPORT", 127);
			fadeto(0,134,200, 1.0, 1.0);
			GiveInventory("Mission_Confirmation", 1);
			delay(150);
			SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
			ChangeLevel("Map29", 0, CHANGELEVEL_NOINTERMISSION, -1);
	}
	else If(CheckInventory("VoidSword") == 0)
	{
		hudmessage(s:"You need the Void Sword to continue";
		HUDMSG_Fadeinout, 11, CR_WHITE, 3.0, 0.80, 3.0);
	}
}

//First Movement//
int Move = 0;
Script 20 (void)
{
	While(True)
	{
		if(Move < 40)
		{
			ThrustThing(192, 1, 0, 1337);
			Move ++;
		}
	delay(3);
	}
}

