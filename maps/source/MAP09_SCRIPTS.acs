script 8 (void)
{
    int buttons;
    Delay(25);
	Thing_Move(1337, 50, 1);
	ACS_Execute(10,0,0,0,0);
	SetActorAngle(1337, 0.75);
	SetActorPitch(1337, 0);
    While (true)
    {
        buttons = GetPlayerInput(-1, INPUT_BUTTONS);

        if(buttons == BT_ATTACK)
        {
			GiveInventory("CP_AmmoFireTrue", 1);
			Thing_Activate(52);
			Thing_Damage(52, 500, MOD_EXIT);
			delay(35);
			Autosave();
            SetPlayerProperty(1,1,PROP_TOTALLYFROZEN);
			ACS_Execute(9,0,0,0,0);
        }
		else if(buttons == BT_USE)
        {
			Autosave();
			ACS_Execute(11,0,0,0,0);
			ACS_Terminate(10,0);
			SetLineBlocking(2, BLOCK_NOTHING);
			delay(6);
			SetActorAngle(52, 0.75);
			delay(6);
			SetActorAngle(52, 1.0);
			delay(6);
			SetActorAngle(52, 0.25);
			delay(6);
			delay(6);
			delay(35);
            SetPlayerProperty(1,1,PROP_TOTALLYFROZEN);
			delay(1);
			ACS_Execute(20,0,0,0,0); //Try to find a way to make the player move forward
			delay(120);
			SetActorState(1337, "See", False);
			ACS_Execute(12,0,0,0,0);
        }
        else
        {
            HudMessage(s:"Press \ci'",k:"+attack", s:"'\cj To Kill Danny\n\nPress \ci'",k:"+use", s:"'\cj To Spare Danny"; HUDMSG_PLAIN, 1, CR_WHITE, 3.0, 0.7, 0.1);
        }
        delay(1);
    }

}

Script 9 (void)
{
		ACS_Terminate(10,0);
		ACS_Terminate(8,0);
		SetLineBlocking(2, BLOCK_NOTHING);
		//Gonna have to make a different actor where it fires instantly
		delay(35);
		ACS_Execute(21,0,0,0,0);
			hudmessageBold(s:"[Jason]\n\cjEasy kill. The Void Sword was mine.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C3M1Q7", 127);
	TakeInventory("CP_sightsColtM1911", 999);
	TakeInventory("CP_sightsP226", 999);
	TakeInventory("CP_sightsRagingBull", 999);
	TakeInventory("CP_sightsGlock20", 999);
}

