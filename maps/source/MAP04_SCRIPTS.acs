script 112 (void)
{
	TakeActorInventory(1337, "HUD_ON", 1);
	ACS_Terminate(111,0);
	SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
	fadeto(255, 255, 255, 1.0, 2.0);
	delay(200);
	changecamera(132, 1, 0);
	Thing_Activate(132);
	delay(50);
	SetMusic("CMC_MUS");
	ACS_Execute(987,0,0,0,0);
	fadeto(0, 0, 0, 0, 2.0);
	hudmessage(s:"Press '", k:"+attack", s:"' to Skip";
	HUDMSG_FADEINOUT, 101, CR_White, 2, 0.9, 999.999);
	hudmessage(s:"[Jason]\n\cjAnd now for the second floor. When Danny and I were going down, the necklace was brighter.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 6.0);
	AmbientSound("quote/C1M3Q15", 127);
	delay(200);
	changecamera(29, 1, 0);
	Thing_Activate(29);
	hudmessage(s:"[Savion]\n\cjLooks like you two were getting closer.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M3Q16", 127);
	delay(130);
	hudmessage(s:"[Savion]\n\cjWas is unsettling be close to enter Ogrodolan?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.5);
	AmbientSound("quote/C1M3Q17", 127);
	delay(165);
	changecamera(137, 1, 0);
	Thing_Activate(137);
	hudmessage(s:"[Jason]\n\cjIt sure was. I didn't know what to expect. Danny on the other hand was nervous to return to Ogrodolan.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 7.0);
	AmbientSound("quote/C1M3Q18", 127);
	delay(240);
	hudmessage(s:"[Jason]\n\cjWhat I can say is, there was something big down there.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M3Q19", 127);
	delay(170);
	fadeto(255, 255, 255, 1.0, 2.0);
	GiveActorInventory(1337, "Mission_Confirmation", 1);
	delay(150);
	ChangeLevel("map27", 0, CHANGELEVEL_NOINTERMISSION, -1);
	}
	
	Script 987 (void)
	{
 int buttons;

 while (TRUE)
 {
   buttons = GetPlayerInput(-1, INPUT_BUTTONS);

   if (buttons & BT_ATTACK)
   {
	GiveActorInventory(1337, "Mission_Confirmation", 1);
	fadeto(255, 255, 255, 1.0, 2.0);
	delay(150);
	ChangeLevel("map27", 0, CHANGELEVEL_NOINTERMISSION, -1);
   }

   delay(1);
 }
}


