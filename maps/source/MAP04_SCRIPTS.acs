Script 100 enter
{
    Thing_ChangeTID (0, 1337+PlayerNumber());
	GiveActorInventory(1337, "HUD_ON", 1);
	SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.75);
	hudmessage(s:"Search\nLocation: Whispering Borderlands (10 Miles From Home)\nJason Milito\nDate: June 5, 2019";
	HUDMSG_TYPEON, 0, CR_GREEN, 2, 0.8, 7.0);
	ChangeSky("SkyDusk", "SkyDusk");
	    If(ChecKInventory("Quest_Danny_Kain_IsHurt") == 1)
	{
		SetPlayerProperty(1, On, PROP_TOTALLYFROZEN);
		ACS_Execute(101,0,0,0,0);
		Thing_move(1337, 25, 1);
		Thing_Remove(53);
		Thing_Remove(49);
		Thing_Remove(110);
		Thing_Remove(116);
	}
	    else If(ChecKInventory("Quest_Danny_Kain_IsNotHurt") == 1)
	{
		SetPlayerProperty(1, On, PROP_TOTALLYFROZEN);
		ACS_Execute(102,0,0,0,0);
		Thing_move(1337, 54, 1);
		Thing_Remove(50);
		Thing_Remove(112);
		Thing_Remove(113);
		Thing_Remove(114);
		Thing_Remove(115);
	}
	 
}

//IF Danny Kain Is Hurt
Script 101 (void)
{
	ACS_Execute(300,0,0,0,0);
	SetLineBlocking(140, BLOCK_PLAYERS);
	hudmessage(s:"[Jason]\n\cjWe had to take a good rest before we left home. Danny was still recovering from his cut.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 6.0);
	AmbientSound("quote/C1M3Q1", 127);
	delay(180);
	SetActorState(50, "Notalk", TRUE);
	ACS_Terminate(300,0);
	hudmessage(s:"[Jason]\n\cjWith the Red Division on the search for us, we had to leave.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C1M3Q3", 127);
	delay(155);
	ACS_Execute(300,0,0,0,0);
	hudmessage(s:"[Savion]\n\cjWere you and Danny still hiding from the Red Division?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C1M3Q4", 127);
	delay(155);
	hudmessage(s:"[Jason]\n\cjNot exactly. Danny mentioned that we had to search for the gateway to Ogrodolan. Now that we had the necklace, we couldn't stop now.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 8.0);
	AmbientSound("quote/C1M3Q5", 127);
	SetActorState(50, "Notalk", TRUE);
	ACS_Terminate(300,0);
	SetActorAngle(50, 0.25);
	delay(6);
	SetActorAngle(50, 0.5);
	delay(300);
	hudmessage(s:"[Jason]\n\cjStrangely enough, the necklace began to glow where we were at.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C1M3Q6", 127);
	ACS_Execute(300,0,0,0,0);
	SetActorAngle(50, 0.5);
	delay(6);
	SetActorAngle(50, 0.25);
	delay(155);
	ACS_Terminate(300,0);
	SetActorState(50, "See", TRUE);
	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
	Thing_Activate(50);
	delay(1);
	Thing_SetGoal(50, 55, 0, 1);
	Autosave();
	delay(100);
	hudmessage(s:"[Jason]\n\cjThe area was quiet..Too quiet.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M3Q7", 127);
	delay(120);
	AmbientSound("weapon/SNPR", 70);
	AmbientSound("sound/SNPIMPA", 70);
	DELAY(50);
	hudmessage(s:"[Jason]\n\cjTurns out we were not alone.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M3Q8", 127);
	Thing_Deactivate(50);
	delay(100);
	hudmessage(s:"[Jason]\n\cjI couldn't see who was on the other side, so Danny took care of that.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C1M3Q9", 127);
	delay(130);
	FadeTo(0,0,0,1.0,3.0);
	delay(130);
	GiveActorInventory(1337, "MORS", 999);
	SpawnSpotForced("Jason_NPC", 112, 8, 64);
	thing_deactivate(8);
	Thing_Remove(50);
	delay(3);
	FadeTo(0,0,0,0.0,3.0);
	setweapon("mors");
	SetMusic("ACTION3");
	thing_activate(113);
	Thing_SetGoal(113, 58, 0, 1);
}

