script 106 ENTER
{
	IF(CheckActorFloorTexture(82, "STEP2") && CheckActorFloorTexture(1337, "STEP2"))
	{
		Floor_LowerToLowest(99, 20);
		delay(2);
		ACS_Terminate(106, 0);
	}
	delay(2);
	restart;
}


script 107 ENTER
{
