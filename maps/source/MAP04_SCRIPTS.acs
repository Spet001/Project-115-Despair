	{
		Floor_RaiseToNearest(100, 20);
		delay(20);
		SetLineBlocking(109, BLOCK_PLAYERS);
		delay(2);
		ACS_Terminate(107, 0);
	}
	delay(2);
	restart;
}

script 108 ENTER
{
	IF(CheckActorFloorTexture(82, "05_AL_15") && CheckActorFloorTexture(1337, "05_AL_15"))
	{
		Door_close(2, 32, 0);
		delay(50);
		Elevator_LowerToNearest(108, 20);
		delay(140);
		Door_Open(3, 32, 0);
		Thing_Activate(82);
		delay(10);
		ACS_Terminate(108, 0);

	}
	delay(2);
	restart;
}

script 109 (void)
{
	hudmessage(s:"[Jason]\n\cjWe arrived underground. There were more Red Division troops in there.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C1M3Q12", 127);
	delay(170);
	hudmessage(s:"[Savion]\n\cjWas it a base for the Red Division?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M3Q13", 127);
	delay(140);
	hudmessage(s:"[Jason]\n\cjNot exactly. There were two floors. The first floor was an abandonded laboratory. Perhaps used to disguise their site.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 8.0);
	AmbientSound("quote/C1M3Q14", 127);
}

