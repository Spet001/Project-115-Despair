int GumBall_Click1 = 10;
int GumBall_Click2 = 10;
int GumBall_Click3 = 10;

int newRand1 = 1;
//When walking up to a PowerGum Machine//
script 60 (void)

{
	if(n == 5)
	{
		HudMessage(s:"\cuCome back next round!";
		HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if(checkinventory("outofsight") >= 1 || checkinventory("LightsOn") >= 1 || checkinventory("ConcealedFighter") >= 1 ||
	checkinventory("QuickPace") >= 1 || checkinventory("LimitlessClip") >= 1 || checkinventory("QuickPace") >= 1 ||
	checkinventory("SubZeroInterval") >= 1 || checkinventory("SwiftDeath") >= 1 || checkinventory("WalkingTank") >= 1 ||
	checkinventory("TriggerHappy") >= 1 || checkinventory("Reinstitute") >= 1 || checkinventory("Vampirism") >= 1 ||
	checkinventory("EnchantedPurchase") >= 1 ||checkinventory("DrinksOnMe") >= 1 || checkinventory("ReplenishedArsenal") >= 1 ||
	checkinventory("DeathUponThem") >= 1 || checkinventory("GamblingFree") >= 1 || checkinventory("StrengthDrainage") >= 1 ||
	checkinventory("IconicDuo") >= 1 || checkinventory("ExtraCredit") >= 1 || checkinventory("RoundSkippin") >= 1 ||
	checkinventory("MirrorTrap") >= 1 || checkinventory("AmeliorationNegotiation") >= 1 || checkinventory("InfiniteSpirit") >= 1 ||
	checkinventory("FatalContraption") >= 1 || checkinventory("SecretShopper") >= 1 || checkinventory("QuantumDischarge") >= 1 ||
	checkinventory("FreeLoan") >= 1 || checkinventory("LockSmith") >= 1 || checkinventory("RadiusMedic") >= 1 ||
	checkinventory("CertifiedElectrician") >= 1 )
	{
		HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu to exchange PowerGum\n\ck[cost:", d: x ,s:"]";
		HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else
	{
		HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu to dispense PowerGum\n\ck[cost:", d: x ,s:"]";
		HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
}

//Gum Ball Machine 1//
Script 61 (void)
{
	if(n == 5)
	{
		HudMessage(s:"\cuCome back next round!";
		HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if (GumUse1 == TRUE)//Ensure that the player can not use the PowerGum Machine while a gumball is dispensed
	{
		HudMessage(s:"";
		HUDMSG_FADEINOUT, 0, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if(checkinventory("outofsight") >= 1 && checkinventory("money") >= x || checkinventory("LightsOn") >= 1 && checkinventory("money") >= x || checkinventory("ConcealedFighter") >= 1 && checkinventory("money") >= x ||
	checkinventory("ConcealedFighter") >= 1 && checkinventory("money") >= x || checkinventory("LimitlessClip") >= 1 && checkinventory("money") >= x || checkinventory("QuickPace") >= 1 && checkinventory("money") >= x ||
	checkinventory("SubZeroInterval") >= 1 && checkinventory("money") >= x || checkinventory("SwiftDeath") >= 1 && checkinventory("money") >= x || checkinventory("WalkingTank") >= 1 && checkinventory("money") >= x ||
	checkinventory("TriggerHappy") >= 1 && checkinventory("money") >= x || checkinventory("Reinstitute") >= 1 && checkinventory("money") >= x || checkinventory("Vampirism") >= 1 && checkinventory("money") >= x ||
	checkinventory("EnchantedPurchase") >= 1 && checkinventory("money") >= x ||checkinventory("DrinksOnMe") >= 1 && checkinventory("money") >= x || checkinventory("ReplenishedArsenal") >= 1 && checkinventory("money") >= x ||
	checkinventory("DeathUponThem") >= 1 && checkinventory("money") >= x || checkinventory("GamblingFree") >= 1 && checkinventory("money") >= x || checkinventory("StrengthDrainage") >= 1 && checkinventory("money") >= x ||
	checkinventory("IconicDuo") >= 1 && checkinventory("money") >= x || checkinventory("ExtraCredit") >= 1 && checkinventory("money") >= x || checkinventory("RoundSkippin") >= 1 && checkinventory("money") >= x ||
	checkinventory("MirrorTrap") >= 1 && checkinventory("money") >= x || checkinventory("AmeliorationNegotiation") >= 1 && checkinventory("money") >= x || checkinventory("InfiniteSpirit") >= 1 && checkinventory("money") >= x ||
	checkinventory("FatalContraption") >= 1 && checkinventory("money") >= x || checkinventory("SecretShopper") >= 1 && checkinventory("money") >= x || checkinventory("QuantumDischarge") >= 1 && checkinventory("money") >= x ||
	checkinventory("FreeLoan") >= 1 && checkinventory("money") >= x || checkinventory("LockSmith") >= 1 && checkinventory("money") >= x || checkinventory("RadiusMedic") >= 1 && checkinventory("money") >= x ||
	checkinventory("CertifiedElectrician") >= 1 && checkinventory("money") >= x)
	{
		TakeInventory(ACS_ExecuteWithResult(660,0,0,0), 999);
		ACS_Terminate(64,0);
		TakeInventory("money", x);
		delay(1);
		x = 500 + 750 * n;
		n = n + 1;
		ThingSound(21, "sound/GUMBUY", 127);
		Delay(40);
		ACS_Execute(62, 0, 0, 0, 0);
		GumActive1 = 1;
		ThingSound(21, "sound/GUMDISP", 127);
		ACS_Terminate(64,0);
	}
	else if(CheckInventory("Money") >= x)
	{
		ACS_Terminate(64,0);
		TakeInventory("money", x);
		delay(1);
		x = 500 + 750 * n;
		n = n + 1;
		ThingSound(21, "sound/GUMBUY", 127);
		Delay(40);
		ACS_Execute(62, 0, 0, 0, 0);
		GumActive1 = 1;
		ThingSound(21, "sound/GUMDISP", 127);
		ACS_Terminate(64,0);
	}
}

script 62 (void)
{
	Thing_Deactivate(21);
	ACS_Terminate(64,0);
	newRand1 = Random(1, 30);
	GumUse1 = True;//Ensure that the player can not use the PowerGum Machine while a gumball is dispensed
	delay(35);
	Thing_SpawnFacing(22, randomGum[newRand1], 1, 994);
    GumActive1 = 0;
    Acs_Execute(63,0,0,0,0);
	}

Script 63 (void)
{
	While(TRUE)
	{
		If(GumBall_Click1 == 0)
		{
			GumBall_Click1 = 10;
			Thing_Activate(21);
			Thing_remove(994);
			delay(40);
			ACS_Execute(64,0,0,0,0);
			GumUse1 = FALSE;
			delay(1);
			Terminate;
		}
		Else If (GumBall_Click1 > 0)
		{

			GumBall_Click1 --;
			Thing_Deactivate(21);
			Delay(10);
			Thing_Activate(21);
			ThingSound(22, "sound/PWRGMCLK", 127);
			Delay(5);
		}
	Delay(10);
	}
}

Script 64 (void)
{
	Thing_Activate(21);
	ThingSound(21, "sound/GUMFLASH", 127);
	Delay(20);
	Thing_Deactivate(21);
	Delay(20);
	RESTART;
}

int newRand2 = 1;

//Gum Ball Machine 2//
Script 65 (void)
{
	if(n == 5)
	{
		HudMessage(s:"\cuCome back next round!";
		HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if (GumUse2 == TRUE)//Ensure that the player can not use the PowerGum Machine while a gumball is dispensed
	{
		HudMessage(s:"";
		HUDMSG_FADEINOUT, 0, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if(checkinventory("outofsight") >= 1 && checkinventory("money") >= x || checkinventory("LightsOn") >= 1 && checkinventory("money") >= x || checkinventory("ConcealedFighter") >= 1 && checkinventory("money") >= x ||
	checkinventory("ConcealedFighter") >= 1 && checkinventory("money") >= x || checkinventory("LimitlessClip") >= 1 && checkinventory("money") >= x || checkinventory("QuickPace") >= 1 && checkinventory("money") >= x ||
	checkinventory("SubZeroInterval") >= 1 && checkinventory("money") >= x || checkinventory("SwiftDeath") >= 1 && checkinventory("money") >= x || checkinventory("WalkingTank") >= 1 && checkinventory("money") >= x ||
	checkinventory("TriggerHappy") >= 1 && checkinventory("money") >= x || checkinventory("Reinstitute") >= 1 && checkinventory("money") >= x || checkinventory("Vampirism") >= 1 && checkinventory("money") >= x ||
	checkinventory("EnchantedPurchase") >= 1 && checkinventory("money") >= x ||checkinventory("DrinksOnMe") >= 1 && checkinventory("money") >= x || checkinventory("ReplenishedArsenal") >= 1 && checkinventory("money") >= x ||
	checkinventory("DeathUponThem") >= 1 && checkinventory("money") >= x || checkinventory("GamblingFree") >= 1 && checkinventory("money") >= x || checkinventory("StrengthDrainage") >= 1 && checkinventory("money") >= x ||
	checkinventory("IconicDuo") >= 1 && checkinventory("money") >= x || checkinventory("ExtraCredit") >= 1 && checkinventory("money") >= x || checkinventory("RoundSkippin") >= 1 && checkinventory("money") >= x ||
	checkinventory("MirrorTrap") >= 1 && checkinventory("money") >= x || checkinventory("AmeliorationNegotiation") >= 1 && checkinventory("money") >= x || checkinventory("InfiniteSpirit") >= 1 && checkinventory("money") >= x ||
	checkinventory("FatalContraption") >= 1 && checkinventory("money") >= x || checkinventory("SecretShopper") >= 1 && checkinventory("money") >= x || checkinventory("QuantumDischarge") >= 1 && checkinventory("money") >= x ||
	checkinventory("FreeLoan") >= 1 && checkinventory("money") >= x || checkinventory("LockSmith") >= 1 && checkinventory("money") >= x || checkinventory("RadiusMedic") >= 1 && checkinventory("money") >= x ||
	checkinventory("CertifiedElectrician") >= 1 && checkinventory("money") >= x)
	{
		TakeInventory(ACS_ExecuteWithResult(660,0,0,0), 999);
		ACS_Terminate(68,0);
		TakeInventory("money", x);
		delay(1);
		x = 500 + 750 * n;
		n = n + 1;
		ThingSound(41, "sound/GUMBUY", 127);
		Delay(40);
		ACS_Execute(66, 0, 0, 0, 0);
		GumActive2 = 1;
		ThingSound(41, "sound/GUMDISP", 127);
		ACS_Terminate(68,0);
	}
	else if(CheckInventory("Money") >= x)
	{
		ACS_Terminate(68,0);
		TakeInventory("money", x);
		delay(1);
		x = 500 + 750 * n;
		n = n + 1;
		ThingSound(41, "sound/GUMBUY", 127);
		Delay(40);
		ACS_Execute(66, 0, 0, 0, 0);
		GumActive2 = 1;
		ThingSound(41, "sound/GUMDISP", 127);
		ACS_Terminate(68,0);
	}
}

script 66 (void)
{
	Thing_Deactivate(41);
	ACS_Terminate(68,0);
	newRand2 = Random(1, 30);
	GumUse2 = True;//Ensure that the player can not use the PowerGum Machine while a gumball is dispensed
	delay(35);
	Thing_SpawnFacing(40, randomGum[newRand2], 1, 993);
    GumActive2 = 0;
    Acs_Execute(67,0,0,0,0);
	}

Script 67 (void)
{
	While(TRUE)
	{
		If(GumBall_Click2 == 0)
		{
			GumBall_Click2 = 10;
			Thing_Activate(41);
			Thing_remove(993);
			delay(40);
			ACS_Execute(68,0,0,0,0);
			GumUse2 = FALSE;
			delay(1);
			Terminate;
		}
		Else If (GumBall_Click2 > 0)
		{

			GumBall_Click2 --;
			Thing_Deactivate(41);
			Delay(10);
			Thing_Activate(41);
			ThingSound(41, "sound/PWRGMCLK", 127);
			Delay(5);
		}
	Delay(10);
	}
}

Script 68 (void)
{
	Thing_Activate(41);
	ThingSound(41, "sound/GUMFLASH", 127);
	Delay(20);
	Thing_Deactivate(41);
	Delay(20);
	RESTART;
}

