Script 430 ENTER
{
	delay(Random(1000, 4000));
	ThingSound(51, "sound/QKRVM", 117);
	delay(Random(1000, 4000));
	ThingSound(53, "sound/DEADM", 117);
	delay(Random(1000, 4000));
	ThingSound(50, "sound/JUGGM", 117);
	delay(Random(1000, 4000));
	ThingSound(52, "sound/SWFTM", 117);
	delay(Random(1000, 4000));
	restart;
}

