script 497 (void)
{
	If(CheckInventory("BlueCard") == 1 && EasterEgg_Step == 3)
	{
		Floor_LowerToLowest(29, 60);
		ThingSound(7, "sound/DOOR", 117);
	}
	else If(CheckInventory("BlueCard") == 0 && EasterEgg_Step < 3)
		{
