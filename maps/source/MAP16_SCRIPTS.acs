/*The PowerGum Mechanic Formula
x = 500 + 750 * n
x is the price of the PowerGum and n is the amount of times the gum ball machine has been used
*/

int n; //The times the gum ball macine has been used
int x = 500;// The initial price

Script 999 ENTER
{	
	GumUse1 = FALSE;
	GumUse2 = FALSE;
	GumUse3 = FALSE;
	FadeTo(0,0,0,1.0,0);
	  //Set up player IDs
    Thing_ChangeTID (0, 1337+PlayerNumber());
	GiveInventory("MaxWeapons", 1);
	delay(1);
	ACS_Execute(334,0,0,0,0);
	Thing_Deactivate(17);
	Thing_Deactivate(80);
	Thing_Deactivate(81);
	Thing_Deactivate(82);
	ACS_Execute(64,0,0,0,0);
	ACS_Execute(68,0,0,0,0);
	ACS_Execute(72,0,0,0,0);
	setlineblocking(1, BLOCK_CREATURES);
	setlineblocking(2, BLOCK_CREATURES);
	setlineblocking(3, BLOCK_PLAYERS);
	setlineblocking(3, BLOCK_CREATURES);
	setlineblocking(4, BLOCK_CREATURES);
	setlineblocking(5, BLOCK_CREATURES);
	setlineblocking(7, BLOCK_CREATURES);
	ChangeSky("ZM_MEDIS", "ZM_MEDIS");
	SetMusic("", 0);
	Scroll_Floor(85, 0, -10, SCROLL_AND_CARRY);
	SpawnSpotForced("Cycle_Part_1", Random(130, 132), 0, 0);
	SpawnSpotForced("Cycle_Part_2", Random(103, 105), 0, 0);
	SpawnSpotForced("Cycle_Part_3", Random(107, 109), 0, 0);
	SpawnSpotForced("Sheild_Part_1", Random(110, 112), 0, 0);
	SpawnSpotForced("Sheild_Part_2", Random(113, 115), 0, 0);
	SpawnSpotForced("Sheild_Part_3", Random(116, 118), 0, 0);
	GiveInventory("Money", 500);
	GiveInventory("ColtM1911", 999);
	GiveInventory("Knife", 999);
	GiveInventory("FragGrenade", 999);
	GiveInventory("HUD_ON", 1);
	TakeInventory("Pistol", 999);
	TakeInventory("Fist", 999);
	TakeInventory("Cursor", 999);
	delay(50);
	FadeTo(0,0,0,0,1.5);
	SetMusic("ZM_MEDIC", 0);
Delay(100);
hudmessage(s:"The Iron Shield Medical Site\nLocation: Window Rock, Arizona\nDate: June 5, 2019";
HUDMSG_TYPEON, 0, CR_GREEN, 2, 0.8, 7.0);
}

//Player 1 Money/Dead
    script 998 ENTER
    
    {
        if(PlayerNumber()==0)
        {
                HudMessageBold(n:1, s:" $", d: CheckactorInventory(1337, "money");
                           HUDMSG_PLAIN, 999, CR_WHITE, 0.0, -0.60, 1.0);
                           {
                        delay(1);
                        {
                        restart;
                        }
                        }
