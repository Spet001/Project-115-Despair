//Juggernog//
Script 210 (void)

{
	HUDMessage(s:"\cuPress \ck", k:"+use", s:" \cu to Purchase Juggernog\n\ck[cost:2500]";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
}

Script 211 (void)
{//Check if the player has purchased this perk//
If (CheckInventory("Juggernog_Confirm") >= 1)
{
		HUDMessage(s:"\cuYou Already Purchased This Perk";
	HUDMSG_FADEINOUT, 7, CR_Gold, 3.0, 0.6, 5.0);
}
	else If (CheckWeapon("DeathMachine"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
//player 1
else if (ActivatorTID() == 1337 && checkactorinventory(1337,"DrinksOnMe") >= 1 && P1PerkSlot == 0)
{
	ACS_Execute(Random(710, 740), 0,0,0,0);
	ThingSound(50, "Sound/BUY", 127);
	ThingSound(50, "Sound/PRKDSPN", 127);
takeactorInventory(1337,"DrinksOnMe", 999);
giveinventory("Juggernog_Drink", 1);
delay(1);
setweapon("Juggernog_Drink");
delay(35*2);
takeinventory("Juggernog_Drink", 255);
Delay(10);
giveactorinventory(1337,"Juggernog", 1);
giveactorinventory(1337,"Juggernog_Icon_S1", 1);
giveactorinventory(1337,"Juggernog_Confirm", 1);
