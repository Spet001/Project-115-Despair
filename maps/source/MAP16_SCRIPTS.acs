script 199 ENTER
{
    while (TRUE)
    {
        if(GetActorZ(1337) >= 300.0)
		{
			AmbientSound("sound/LAUGh", 127);
			delay(100);
			Thing_Damage(1337, 999, MOD_EXIT);
		}
        Delay(60);
    }
}

