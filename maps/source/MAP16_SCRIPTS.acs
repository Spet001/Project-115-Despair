Script 334 (void)
{
While (true)
{
	If (CheckActorInventory(1340, "StrengthDrainage") == 1 && ThingCountName("SlowZombie1", 102) == 0 && ThingCountName("SlowZombie2", 102) == 0 && 
	ThingCountName("NormalZombie1", 102) == 0 && ThingCountName("NormalZombie2", 102) == 0 &&
	ThingCountName("FastZombie1", 102) == 0 && ThingCountName("FastZombie2", 102) == 0 &&
	ThingCountName("SprintingZombie1", 102) == 0 && ThingCountName("SprintingZombie2", 102) == 0 &&
	ThingCountName("SlowZombie3", 102) == 0 && ThingCountName("NormalZombie3", 102) == 0 &&
	ThingCountName("FastZombie3", 102) == 0 && ThingCountName("SprintingZombie3", 102) == 0 &&
	ThingCountName("SlowZombie4", 102) == 0 && ThingCountName("NormalZombie4", 102) == 0 && 
	ThingCountName("FastZombie4", 102) == 0 && ThingCountName("SprintingZombie4", 102) == 0 &&
	ThingCountName("SlowJumpingZombie", 102) == 0 && ThingCountName("NormalJumpingZombie", 102) == 0 &&
	ThingCountName("FastJumpingZombie", 102) == 0 && ThingCountName("SprintingJumpingZombie", 102) == 0 && 
	ThingCountName("SlowRedZombie5", 102) == 0 && ThingCountName("NormalRedZombie5", 102) == 0 &&
	ThingCountName("FastRedZombie5", 102) == 0 && ThingCountName("SprintingRedZombie5", 102) == 0)
	{
		RoundActive = FALSE;
		ACS_Execute(804,0,0,0,0);
		ACS_Execute(805,0,0,0,0);
		ACS_Execute(806,0,0,0,0);
		ACS_Execute(807,0,0,0,0);
		AmbientSound("ROUNDMED/ROUNDME", 127);
		ACS_Terminate(301,0);
		TakeActorInventory(1340, "StrengthDrainage", 1);
