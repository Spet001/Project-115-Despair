//Off The Wall Weapons

 script 100 (void)
 
{
if (CheckInventory("SecretShopper") > 0)
	{
	SetFont("DIETLOGFONT");
	HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu to refill ammo\n\ck[cost:2500]";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if (CheckInventory("PAPM-14"))
	{
	SetFont("DIETLOGFONT");
	HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu to buy Ammo \n\ck[cost:4200]";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if (CheckInventory("M-14"))
	{
	SetFont("DIETLOGFONT");
	HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu to buy Ammo \n\ck[cost:400]";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if (!CheckInventory("M-14"))
	{
	SetFont("DIETLOGFONT");
	HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu to buy the M-14 Assault Rifle \n\ck[cost:800]";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
}

script 101 (void)
 
{
		If (CheckWeapon("Knife"))
	{
	SetFont("DIETLOGFONT");
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("FragGrenade"))
	{
	SetFont("DIETLOGFONT");
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("PlasmaGrenade"))
	{
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("RadiationGrenade"))
	{
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("QuickRevive_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("SwiftHands_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("DeadShot_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("ShockTop_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("Flak_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("Blood_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("DeathMachine"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
		else If (CheckInventory("MaxWeapons") < 2 && CheckWeapon("AssaultShield"))
	{
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckInventory("MaxWeapons") == 2 && CheckWeapon("AssaultShield"))
	{
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else if (CheckInventory("SecretShopper") > 0 && CheckInventory("money") >= 2500)
	{
	thingsound(9, "sound/buy", 120);
	TakeInventory("money",2500);
	ACS_Execute(120,0,0,0,0);
	ACS_Execute(Random(710, 740), 0,0,0,0);
	}
else if(CheckInventory("PAPM-14") && CheckInventory("money") >= 4200)
                {
                        GiveInventory("PAPM-14AMMO", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                        thingsound(9, "sound/buy", 120);
                        TakeInventory("money",4200);
						ACS_Execute(Random(710, 740), 0,0,0,0);
                }
  
 else if(CheckInventory("M-14") && CheckInventory("money") >= 400)
                {
                        GiveInventory("M-14", 255);
                        GiveInventory("M-14AMMO", 255);
                        GiveInventory("M-14AMMO", 255);
                        GiveInventory("M-14AMMO", 255);
                        thingsound(9, "sound/buy", 120);
                        TakeInventory("money",400);
						ACS_Execute(Random(710, 740), 0,0,0,0);
                }
	else if(!CheckInventory("M-14")  && CheckInventory("EnchantedPurchase") && CheckInventory("MaxWeapons") == 2 && CheckInventory("money") >= 800)
                {
                        GiveInventory("PAPM-14", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                    TakeInventory("money",800);
		TakeInventory(ACS_ExecuteWithResult(53,0,0,0), 999);
		TakeInventory("EnchantedPurchase",999);
                    thingsound(9, "sound/buy", 120);
                    thingsound(9, "sound/PAPbuy", 120);
                    SetWeapon("PAPM-14");
					ACS_Execute(Random(710, 740), 0,0,0,0);
			
                }
	else if(!CheckInventory("M-14")  && CheckInventory("EnchantedPurchase") && CheckInventory("MaxWeapons") < 2 && CheckInventory("money") >= 800)
                {
                        GiveInventory("MaxWeapons", 1);
                        GiveInventory("PAPM-14", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                        GiveInventory("PAPM-14AMMO", 255);
                    TakeInventory("money",800);
		TakeInventory("EnchantedPurchase",999);
                    thingsound(9, "sound/buy", 120);
                    thingsound(9, "sound/PAPbuy", 120);
                    SetWeapon("PAPM-14");
		ACS_Execute(Random(710, 740), 0,0,0,0);

                }
                else if(!CheckInventory("M-14")  && !CheckInventory("PAPM-14") && CheckInventory("MaxWeapons") == 2 && CheckInventory("money") >= 800)
                {
                        GiveInventory("M-14", 255);
                        GiveInventory("M-14AMMO", 255);
                        GiveInventory("M-14AMMO", 255);
                        GiveInventory("M-14AMMO", 255);
		TakeInventory(ACS_ExecuteWithResult(53,0,0,0), 999);
                    TakeInventory("money",800);
                    thingsound(9, "sound/buy", 120);
                    thingsound(9, "sound/newbuy", 120);
                    SetWeapon("M-14");
		ACS_Execute(Random(710, 740), 0,0,0,0);

                }
                else if(!CheckInventory("M-14")  && !CheckInventory("PAPM-14") && CheckInventory("MaxWeapons") < 2 && CheckInventory("money") >= 800)
                {
                        GiveInventory("MaxWeapons", 1);
                        GiveInventory("M-14", 255);
                        GiveInventory("M-14AMMO", 255);
                        GiveInventory("M-14AMMO", 255);
                        GiveInventory("M-14AMMO", 255);
                    TakeInventory("money",800);
                    thingsound(9, "sound/buy", 120);
                    thingsound(9, "sound/newbuy", 120);
                    SetWeapon("M-14");
		ACS_Execute(Random(710, 740), 0,0,0,0);

                }


     }
	 	 
