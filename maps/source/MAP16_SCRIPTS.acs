	else If (BoxUse1 == True && CheckInventory("MaxWeapons") < 2 &&CheckWeapon("ShockTop_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (BoxUse1 == True && CheckInventory("MaxWeapons") < 2 &&CheckWeapon("Flak_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (BoxUse1 == True && CheckInventory("MaxWeapons") < 2 &&CheckWeapon("Blood_Drink"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("AssaultShield"))
	{
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	else If (CheckWeapon("DeathMachine"))
	{
	HudMessage(s:"\cuYou can not trade this weapon";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}

else If (BoxUse1 == True && CheckInventory("MaxWeapons") == 2)
	{
		Thing_Remove(400);//Remove the weapon displayed.
		Thingsound(81, "sound/BOXWEPSL", 120);
		Thingsound(81, "sound/buy", 120);
		TakeInventory(ACS_ExecuteWithResult(53,0,0,0), 999);
		GiveInventory(randomweapon[CurrentWeapon], 1);
		SetWeapon(randomweapon[CurrentWeapon]);
		ChangeFloor(68, "RBOX1");
		ACS_Terminate(52,0);
		delay(6);
		BoxUse1 = FALSE; //The Box can be used again.
		Terminate;
	}
else If (BoxUse1 == True && CheckInventory("MaxWeapons") < 2)
	{
		GiveInventory("MaxWeapons", 1);
		Thing_Remove(400);//Remove the weapon displayed.
		Thingsound(81, "sound/BOXWEPSL", 120);
		Thingsound(81, "sound/buy", 120);
		GiveInventory(randomweapon[CurrentWeapon], 1);
		SetWeapon(randomweapon[CurrentWeapon]);
		ChangeFloor(68, "RBOX1");
		ACS_Terminate(52,0);
		delay(6);
		BoxUse1 = FALSE; //The Box can be used again.
		Terminate;
	}
//If the player spins the box.
	Else if (BoxUse1 == False && CheckInventory("GamblingFree") >= 1)
	{
	ACS_Execute(Random(710, 740), 0,0,0,0);
	Thingsound(81, "sound/BOXWEPCY", 120);
	Takeinventory("GamblingFree",1);
	ChangeFloor(68, "RBOX2");
	Delay(35);
	ACS_Execute(54,0,0,0,0);
}
	Else if (BoxUse1 == False && CheckInventory("Money") >= 950)
	{
	ACS_Execute(Random(710, 740), 0,0,0,0);
	Thingsound(81, "sound/BOXWEPCY", 120);
	Takeinventory("money",950);
	ChangeFloor(68, "RBOX2");
	Delay(35);
	ACS_Execute(54,0,0,0,0);
}
}

Script 52 (void)
{
	BoxUse1 = TRUE;
    delay(35*6);
    thingsound(81, "sound/BOXWEPGN", 120);
    DELAY(35*3);
    Thing_Remove(400);
    	BoxUse1 = False;
        ChangeFloor(68, "RBOX1");
}

Script 54 (void)
	{
		//This int is used to check how many weapons have cycled through before picking one.
		int WeaponsCycled = 0;
			
				While (WeaponsCycled < 15)
				{
				Thing_SpawnFacing(81, WeaponVariable[CurrentWeapon], 1, 400);
				delay(1);
				CurrentWeapon = Random(1, 30);
				delay(2);
				Thing_Remove(400);
				delay(1);
				WeaponsCycled ++;
				}
				if (WeaponsCycled == 15 && WeaponVariable[CurrentWeapon] == 0) 
				{
				Thing_SpawnFacing(81, "Glock20", 1, 400);
				HudMessage(s:"\cuAn Error Has Occured\nPoints Refunded";
				HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
				delay(1);
				Thing_Remove(400);
				BoxUse1 = False;
				ChangeFloor(68, "RBOX1");
				GiveInventory("money",950);
				}
				if (WeaponsCycled == 15)
				{
				Thing_SpawnFacing(81, WeaponVariable[CurrentWeapon], 1, 400);
				ACS_Execute(52,0,0,0,0);
			}
			delay(1);
	}

