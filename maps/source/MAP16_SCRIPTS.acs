	SetActorProperty(0, APROP_Invulnerable, OFF);
	SetPlayerProperty(0, OFF, PROP_FROZEN);
}

//Step 2: Grab the key
script 512 (void)
{
	if (EasterEgg_Step == 2 && CheckInventory("Fuse") == 1)
	{
SpawnSpotForced("Fuse_Prop", 145, 0, 0);
TakeInventory("Fuse", 1);
SpawnSpotForced("Fuse", 146, 0, 0);
}
}

script 513 (void)

{
	if (EasterEgg_Step == 2 && CheckInventory("Fuse") == 1)
	{
SpawnSpotForced("Fuse_Prop", 147, 0, 0);
TakeInventory("Fuse", 1);
delay(6);
SpawnSpotForced("Bluecard", 1, 0, 0);
EasterEgg_Step ++;
}
}

//Step 3: Fill the conversion with water
Script 514 (void)
{
	if (EasterEgg_Step == 3 && CheckInventory("FuelConversion") == 1)
	{
EasterEgg_Step ++;
ambientsound("JUGGER/ALERT",127);
delay(35*2);
SetActorProperty(200, APROP_Health, BossHealth);
	SpawnSpotForced("RedDivisionJuggernaut_Lever", 6, 200, 0);
	Delay(35*3);
	ambientsound("sound/JUGALARM",120);
}
}


//Step 4: Add the lever

script 517 (void)
{
	if (EasterEgg_Step == 4 && CheckInventory("Lever") == 1)
	{
EasterEgg_Step ++;
SetLineTexture(6, SIDE_FRONT, TEXTURE_BOTTOM, "SW1EST");
TakeInventory("Lever", 255);
}
	ELSE if (EasterEgg_Step < 4)
	{
print(s:"A lever is missing");
}
}

//Step 5: Power up the tram
Script 518 (void)
{
if (EasterEgg_Step == 5)
	{
Thing_Move(0, 3, 1);
ACS_Terminate(499,0);
}
}

Script 519 (void)
{
	if (EasterEgg_Step == 5 && CheckInventory("FuelConversion") == 1)
	{
		SpawnSpotForced("FuelConversion_Prop", 4, 0, 0);
		TakeInventory("FuelConversion", 1);
		ThingSound(106, "craft/built", 127);
			setmusic("ZM_EE2BO");
	SpawnSpotForced("AgarthanTank", 20, 500, 0);
		Thing_Remove(5);
		ACS_Execute(523,0,0,0,0);
		ACS_Execute(524,0,0,0,0);
		ACS_Execute(520,0,0,0,0);
		delay(2);
		ACS_Execute(522,0,0,0,0);
		SetActorProperty(500, APROP_HEALTH, 100000);
	}
}

script 520 (void)
{
	While(True)
	{
		If(ThingCountName("FastZombie1", 400) <= 9 && ThingCountName("FastZombie2", 400) <= 9)
		{
	Delay(40);
	SpawnSpotFacingForced("FastZombie1", Random(205, 208), 400);
	delay(40);
	SpawnSpotFacingForced("FastZombie2", Random(205, 208), 400);
		}
	If(ThingCountName("FastZombie1", 400) == 10 && ThingCountName("FastZombie2", 400) == 10)
	{
		print(s:"");
	}
		Delay(1);
	}
}

script 524 (void)
{
	While(True)
	{
		If(ThingCountName("RedDivisionJuggernaut", 400) <= 2)
		{
	Delay(40*30);
	SpawnSpotFacingForced("RedDivisionJuggernaut", Random(205, 208), 400);
		}
	If(ThingCountName("RedDivisionJuggernaut", 400) == 3)
	{
		print(s:"");
	}
		Delay(1);
	}
}


script 521 (void)
{
	if (EasterEgg_Step >= 6)
	{
ACS_Terminate(520,0);
ACS_Execute(510,0,0,0,0);
Thing_Destroy(400, 0, 0);
Floor_LowerToLowest(97, 20);
}
	else if (EasterEgg_Step < 6)
	{
print(s:"Not enough power");
}
}

script 522 (void)

{
	HudMessage(s:"Agarthan Tank";
	HUDMSG_PLAIN, 995, CR_ORANGE, 3.0, 0.14, 1.0);
	HudMessage(d: GetActorProperty(500, APROP_Health);
	HUDMSG_PLAIN, 994, CR_DARKRED, 3.0, 0.19, 1.0);
	delay(1);
	Restart;
}

script 523 (void)
{
	While(True)
	{
		If(GetActorProperty(500, APROP_Health) <= 0)
		{
			ACS_Terminate(522,0);
			ACS_Terminate(520,0);
			ACS_Terminate(524,0);
			EasterEgg_Step ++;
			Thing_Destroy(400, 0, 0);
		}
		Delay(1);
	}
}

