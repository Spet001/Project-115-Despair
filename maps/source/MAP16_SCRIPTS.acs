//Easter Egg: Escape The Iron Shield//
//Step 1: Place the fuses//
script 506 (void)
{
if (EasterEgg_Step == 1 && FusePlace == 0 && CheckInventory("Fuse") == 1)
{
SpawnSpotForced("Fuse_Prop", 140, 0, 0);
TakeInventory("Fuse", 1);
FusePlace ++;
Thing_Activate(80);
}
}
