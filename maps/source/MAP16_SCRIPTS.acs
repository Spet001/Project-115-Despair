script 113 (void)
 
{
	if(CheckInventory("RadiationGrenade") && CheckInventory("money") >= 4000)
	{
		GiveInventory("RadiationGrenadeAmmo", 3);
		TakeInventory("money",4000);
		Thingsound(14, "sound/buy", 120);
		ACS_Execute(Random(710, 740), 0,0,0,0);
	}
	else if(!CheckInventory("RadiationGrenade") && CheckInventory("money") >= 4000)
	{
		GiveInventory("RadiationGrenade", 1);
		GiveInventory("RadiationGrenadeAmmo", 3);
		TakeInventory("money",4000);
		Thingsound(14, "sound/buy", 120);
		Thingsound(14, "sound/newbuy", 120);
		ACS_Execute(Random(710, 740), 0,0,0,0);
	}
}


