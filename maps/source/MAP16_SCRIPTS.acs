//Perks//
int QuickRevive_UsesP1 = 3;
int QuickRevive_UsesP2 = 3;
int QuickRevive_UsesP3 = 3;
int QuickRevive_UsesP4 = 3;
//Quick Revive//

Script 200 (void)
{
	if(ActivatorTID() == 1337)
	{
	HUDMessage(s:"\cuPress \ck", k:"+use", s:" \cu to Purchase Quick Revive\n\ck[cost:1500]\n\cuYou have \ci", d: QuickRevive_UsesP1, s:" \cuLeft";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	Else if(ActivatorTID() == 1338)
	{
	HUDMessage(s:"\cuPress \ck", k:"+use", s:" \cu to Purchase Quick Revive\n\ck[cost:1500]\n\cuYou have \ci", d: QuickRevive_UsesP2, s:" \cuLeft";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	Else if(ActivatorTID() == 1339)
	{
	HUDMessage(s:"\cuPress \ck", k:"+use", s:" \cu to Purchase Quick Revive\n\ck[cost:1500]\n\cuYou have \ci", d: QuickRevive_UsesP3, s:" \cuLeft";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
	Else if(ActivatorTID() == 1340)
	{
	HUDMessage(s:"\cuPress \ck", k:"+use", s:" \cu to Purchase Quick Revive\n\ck[cost:1500]\n\cuYou have \ci", d :QuickRevive_UsesP4, s:" \cuLeft";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
}

Script 201 (void)//If the player has used up all their Quick Revives,//
				//tell him/her that they can not purchase another one//
//player 1
if (ActivatorTID() == 1337 && QuickRevive_UsesP1 == 0)
{
HUDMessage(s:"\cuYou have no more uses";
HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.6, 5.0);
}
//player 2
Else if (ActivatorTID() == 1338 && QuickRevive_UsesP2 == 0)
{
HUDMessage(s:"\cuYou have no more uses";
HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.6, 5.0);
}
//player 3
Else if (ActivatorTID() == 1339 && QuickRevive_UsesP3 == 0)
{
HUDMessage(s:"\cuYou have no more uses";
HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.6, 5.0);
}
//player 4
Else if (ActivatorTID() == 1340 && QuickRevive_UsesP4 == 0)
{
HUDMessage(s:"\cuYou have no more uses";
HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.6, 5.0);
}

//Check if the player has purchased this perk//
else If (CheckInventory("QuickRevive_Confirm") >= 1)
{
		HUDMessage(s:"\cuYou Already Purchased This Perk";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.6, 5.0);
}
	else If (CheckWeapon("DeathMachine"))
	{
	HudMessage(s:"";
	HUDMSG_FADEINOUT, 6, CR_Gold, 3.0, 0.7, 5.0);
	}
//player 1
else if (ActivatorTID() == 1337 && checkactorinventory(1337,"DrinksOnMe") >= 1 && P1PerkSlot == 0)
{
	ACS_Execute(Random(710, 740), 0,0,0,0);
