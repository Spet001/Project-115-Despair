script 803 death

{
	If(CheckActorInventory(1337, "Money") == 0 && CheckActorInventory(1338, "Money") == 0 &&
	CheckActorInventory(1339, "Money") == 0 && CheckActorInventory(1340, "Money") == 0)
    {
		setActorProperty(1337, APROP_Health,0);
		setActorProperty(1338, APROP_Health,0);
		setActorProperty(1339, APROP_Health,0);
		setActorProperty(1340, APROP_Health,0);
		setActorProperty(1337, APROP_Invulnerable,OFF);
		setActorProperty(1338, APROP_Invulnerable,OFF);
		setActorProperty(1339, APROP_Invulnerable,OFF);
		setActorProperty(1340, APROP_Invulnerable,OFF);
      SetFont("BIGFONT");
  HUDMessageBold(s:"Game over";
             HUDMSG_PLAIN, 0, CR_white, 3.0, 0.2, 9999.9999);
             SETFONT("SMALLFONT");
              HUDMessageBold(s:"You survived ", d:RoundNumber, s:" Rounds!";
              HUDMSG_PLAIN, 0, CR_white, 3.0, 0.3, 9999.9999);
			  setmusic("ZM_MEDG", 0, 0);
			  Thing_Activate(67);
			  Thing_Activate(68);
			  Thing_Activate(69);
fadeto(0, 0, 0, 1.0, 5.0);
DELAY(200);
   delay(1);
   clearinventory();
   delay(1);
fadeto(0, 0, 0, 0, 5.0);
ChangeCamera(Random(67, 69),1,0);
delay(250);
fadeto(0, 0, 0, 1.0, 6.9);
delay(240);
changelevel("map01", 0, changelevel_nointermission, -1);
}
}

script 756 ENTER
{//HEALTH REGENERATION
    int health = GetActorProperty(1337, APROP_Health);

    While(True)
    {
        {
            //Constantly work while health is under 100
            While(GetActorProperty(1337,APROP_Health)<100 && GetActorProperty(1337,APROP_Health)>=1)
            {
                //After each hit you take, wait for regeneration
                If(GetActorProperty(1337,APROP_Health)<health)
                {
                HudMessage(s:"";HUDMSG_FADEOUT, 101, CR_RED, 240.0, 180.0, 0.1, 2.0);
                }
                health = GetActorProperty(1337, APROP_Health);
                SetActorProperty(1337, APROP_Health, health + 1);
                Delay(3);
            }
        }
    Delay(1);
    }
}

script 757 ENTER
{//HEALTH REGENERATION
    int health = GetActorProperty(1338, APROP_Health);

    While(True)
    {
        {
            //Constantly work while health is under 100
            While(GetActorProperty(1338,APROP_Health)<100 && GetActorProperty(1338,APROP_Health)>=1)
            {
                //After each hit you take, wait for regeneration
                If(GetActorProperty(1338,APROP_Health)<health)
                {
                HudMessage(s:"";HUDMSG_FADEOUT, 101, CR_RED, 240.0, 180.0, 0.1, 2.0);
                }
                health = GetActorProperty(1338, APROP_Health);
                SetActorProperty(1338, APROP_Health, health + 1);
                Delay(3);
            }
        }
    Delay(1);
    }
}

