script 7 (void)
{
	While(True)
	{
		If(ThingCountName("CP_SlowZombie1", 101) == 0 && ThingCountName("CP_SlowZombie2", 101) == 0)
		{
	Delay(40);
	SpawnSpotFacingForced("CP_SlowZombie1", Random(30, 35), 101);
	delay(40);
	SpawnSpotFacingForced("CP_SlowZombie2", Random(30, 35), 101);
		}
	If(ThingCountName("CP_SlowZombie1", 101) == 5 && ThingCountName("CP_SlowZombie2", 101) == 5)
	{
		print(s:"");
	}
		Delay(1);
	}
}
