}

script 1 ENTER
{
	Thing_ChangeTID (0, 1337+PlayerNumber());
		SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.25);
 Thing_Activate(25);
 Thing_SetGoal(25, 1, 0, 0);
 delay(20);
 	hudmessage(s:"[Jason]\n\cjDanny was in a hurry. A little more quicker than before.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 7.0);
	AmbientSound("quote/C2M1Q1", 127);
         SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
        SetPlayerProperty(1, 0, PROP_FROZEN);
            SetMusic("CPN_M4", 0);
			
    GiveActorInventory(1337, "HUD_ON", 1);
	hudmessage(s:"Divided\nLocation: Ogrodolan\nJason Milito\nDate: June 5, 2019";
	HUDMSG_TYPEON, 0, CR_GREEN, 2, 0.8, 7.0);
	changecamera(0, 1, 0);
     	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
}

script 2 (void)
{
	delay(20);
	Floor_LowerToLowest(2, 50);
	Radius_Quake(20, 5, 0, 2, 0);
delay(100);
	hudmessageBold(s:"[Jason]\n\cjA chunk of the bridge broke and Danny fell with it. There was something ahead as well. The scarecrow; a demon like Phoenix. Not just one, but multiple.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 9.0);
	AmbientSound("quote/C2M1Q2", 127);
 Thing_Remove(25);
 delay(100);
 Autosave();
SetLineBlocking(3, BLOCK_NOTHING);
	SpawnSpotForced("Scarecrow", 26, 27, 0);
	delay(1);
	Thing_Hate(26, 1337, 0);
	ACS_Execute(4,0,0,0,0);
	setmusic("ACTION5", 0, 0);
}

script 4 (void)
{	
	While(TRUE)
		{
		if(ThingCountName("Scarecrow", 27) == 0)
		{
		ACS_Execute(5,0,0,0,0);
		}
		delay(1);
	}
}

Script 5 (void)
{
	delay(1);
	Autosave();
	ACS_Terminate(4,0);
	delay(20);
	SpawnSpotForced("Waypoint", 28, 29, 0);
	SetLineBlocking(1, BLOCK_NOTHING);
	setmusic("CPM_OGR", 0, 0);
	ACS_Execute(7,0,0,0,0);
	hudmessageBold(s:"[Jason]\n\cjI was surprised to not see any Red Division Troops down here. From there, I was fighting creatures not seen on earth.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 7.0);
	AmbientSound("quote/C2M1Q3", 127);
	delay(300);
		hudmessageBold(s:"[Savion]\n\cjWhat about Danny?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C2M1Q4", 127);
	delay(120);
	hudmessageBold(s:"[Jason]\n\cjI wouldn't be able to jump down there to find him. I had to continue on. With or without Danny.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C2M1Q5", 127);
		delay(230);
	hudmessageBold(s:"[Jason]\n\cjAs we were exiting the portal, he said to find a weapon called the Void Sword. I wasn't told where to go. I was lost.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 6.0);
	AmbientSound("quote/C2M1Q6", 127);

}

