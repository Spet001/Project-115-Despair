script 61 (void)
{
	
		If(Ruby == 1 && Sapphire == 1 && Diamond == 1)
	{
	AmbientSound("sound/ESTR_STP", 127);
	delay(10);
	hudmessageBold(s:"[Jason]\n\cjI got the three gems in their place.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C2M1Q8", 127);
	delay(130);
	hudmessageBold(s:"[Jason]\n\cjI decided to take a rest. The lack of sleep I got left me exhausted.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 7.0);
	AmbientSound("quote/C2M1Q9", 127);
	delay(190);
	hudmessageBold(s:"[Jason]\n\cjI went to sit down against a wall.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C2M1Q10", 127);
	FadeTo(0,0,0,1.0,7.0);
	SetPlayerProperty(1, 1, PROP_FROZEN);
