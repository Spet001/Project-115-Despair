#include "zcommon.acs"

int stage = 1;
int shots_fired = 0;

Script 1 ENTER
{
	SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.25);
	GiveInventory("ARCJasper", 999);
	SetWeapon("ARCJasper");
	ChangeCamera(1,1,0);
	delay(1);
	restart;
}

Script 2 ENTER
{
		SetMusic("ARCMUS3");
	Thing_ChangeTID(0, 1337);
}

script 7 (void)
{
	AmbientSound("sound/ARCFIRE", 127);
	shots_fired ++;
}

