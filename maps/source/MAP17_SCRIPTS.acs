{
	SpawnSpotFacingForced("PLANT1", Random(12, 17), 100);
	delay(25);
	SpawnSpotFacingForced("PLANT2", Random(12, 17), 100);
	delay(25);
	SpawnSpotFacingForced("PLANT3", Random(12, 17), 100);
	delay(25);
	SpawnSpotFacingForced("PLANT4", Random(12, 17), 100);
	delay(25);
	restart;
}