#include "Zcommon.acs"
//Outro Cutscene//
Script 1 enter
{
	ChangeSky("ZM_ASYLM", "ZM_ASYLM");
	FadeTo(255, 255, 255, 1.0, 0);
	Thing_Deactivate(9);
	Thing_Deactivate(61);
	Thing_Deactivate(62);
	Thing_Deactivate(63);
	Consolecommand("Screenblocks 12");
	AmbientSound("sound/OUTRO2", 127);
	SetMusic("", 0);
	delay(370);
	ChangeCamera(1, 1, 0);
	Thing_Activate(1);
	FadeTo(0, 0, 0, 0.0, 3.0);
	HudMessageBold(s:"[Jason]\n\cjWith the work of Darwin and Otekah, they got me into this jar.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	Delay(200);
	HudMessageBold(s:"[Otekah]\n\cjHow are you doing?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	Thing_Activate(9);
	Thing_SetGoal(9, 7, 0, 0);
	ChangeCamera(4, 1, 0);
	Thing_Activate(4);
	Delay(40);
	//Faith
	Thing_Activate(61);
	Thing_Move(61, 21, 1);
	Thing_SetGoal(61, 19, 0, 0);
	//Darwin
	Thing_Activate(62);
	Thing_Move(62, 22, 1);
	Thing_SetGoal(62, 23, 0, 0);
	//Zachery
	Thing_Activate(63);
	Thing_Move(63, 30, 1);
	Thing_SetGoal(63, 24, 0, 0);
	/////////////////////////
	ChangeCamera(46, 1, 0);
	Thing_Activate(46);
	HudMessageBold(s:"[Jason]\n\cjI’m doing well. Came on time to replace the filter.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	SetActorAngle(61, 0.25);
	SetActorAngle(62, 0.25);
	SetActorAngle(63, 0.25);
	Delay(180);
	SetActorAngle(9, 0.5);
	HudMessageBold(s:"[Jason]\n\cjCredit to these kids. Because of them, I can live longer.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	SetActorAngle(61, 0.25);
	SetActorAngle(62, 0.25);
	SetActorAngle(63, 0.25);
	Thing_Deactivate(9);
	Thing_Deactivate(61);
	Thing_Deactivate(62);
	Thing_Deactivate(63);
	Delay(130);
	ChangeCamera(37, 1, 0);
	Thing_Activate(37);
	HudMessageBold(s:"[Otekah]\n\cjThat’s what’s up!";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	Delay(70);
	ChangeCamera(49, 1, 0);
	Thing_Activate(49);
	Thing_Remove(61);
	Thing_Remove(62);
	Thing_Remove(63);
	HudMessageBold(s:"[Jason]\n\cjHey Otekah. Could you replace and check on the IV bag?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	Delay(130);
	HudMessageBold(s:"[Otekah]\n\cjSure thing!";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 2.0);
	Delay(50);
	ChangeCamera(52, 1, 0);
	Thing_Activate(52);
	Thing_Remove(9);
	SpawnSpotForced("Otekah_Comic", 13, 14, 192);
	SpawnSpotForced("Zachery_Comic", 68, 71, 192);
	SpawnSpotForced("Darwin_Comic", 69, 72, 192);
	SpawnSpotForced("Faith_Comic", 70, 73, 192);
	Thing_SetGoal(73, 76, 0, 0);//Faith
	delay(4);
	Thing_SetGoal(72, 75, 0, 0);//Darwin
	delay(4);
	Thing_SetGoal(71, 74, 0, 0);//Zachery
	delay(30);
	ChangeCamera(55, 1, 0);
	Thing_Activate(55);
	Thing_Move(71, 30, 1);
	delay(70);
	ChangeCamera(58, 1, 0);
	Thing_Activate(58);
	Thing_SetGoal(14, 15, 0, 0);
	delay(20);
	Thing_Remove(14);
	Thing_Remove(72);
	Thing_Remove(73);
	Thing_Remove(71);
	SpawnSpotForced("Faith_Comic", 80, 90, 192);
	SpawnSpotForced("Darwin_Comic", 81, 91, 192);
	SpawnSpotForced("Zachery_Comic", 82, 92, 192);
	SpawnSpotForced("Otekah_Comic", 83, 93, 192);
	SetActorAngle(90, 0.75);
	SetActorAngle(91, 0.75);
	SetActorAngle(92, 0.75);
	SetActorAngle(93, 0.75);
	Thing_Deactivate(90);
	Thing_Deactivate(91);
	Thing_Deactivate(92);
	Thing_Deactivate(93);
	HudMessageBold(s:"[Faith]\n\cjI did not think I was going to make it.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	Delay(80);
	HudMessageBold(s:"[Darwin]\n\cjThat was so much fun!";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	Delay(180);
	ChangeCamera(65, 1, 0);
	Thing_Activate(65);
	HudMessageBold(s:"[Zachery]\n\cjNothing like a good team.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	delay(160);
	FadeTo(0, 0, 0, 1.0, 5.0);
	delay(180);
	Acs_Execute(85,0,0,0,0);
	Delay(200);
	Acs_Execute(86,0,0,0,0); 
	Delay(70);
	Acs_Execute(87,0,0,0,0);
	Delay(200);
	Acs_Execute(88,0,0,0,0);
	Delay(90);
	Acs_Execute(89,0,0,0,0);
	Delay(70);
	Acs_Execute(90,0,0,0,0);
	Delay(70);
	Acs_Execute(91,0,0,0,0);
	Delay(70);
	Acs_Execute(92,0,0,0,0);
	Delay(70);
	Acs_Execute(93,0,0,0,0);
	Delay(120);
	Acs_Execute(66,0,0,0,0);
	delay(200);
	Acs_Execute(84,0,0,0,0);
	Delay(200);
	Acs_Execute(61,0,0,0,0); 
	Delay(200);
	Acs_Execute(62,0,0,0,0);
	Delay(200);
	Acs_Execute(63,0,0,0,0);
	Delay(130);
	Acs_Execute(64,0,0,0,0);
	Delay(120);
	Acs_Execute(65,0,0,0,0);
}

