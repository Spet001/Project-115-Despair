Script 74 (void) //INITIATES MISSION START//
{
	GiveInventory("Knife", 1);
	SetPlayerProperty(1, 1, PROP_TOTALLYFROZEN);
	DELAY(20);
	fadeto(255, 255, 255, 1.0, 1.0);
	delay(70);
	fadeto(0, 0, 0, 0, 1.0);
        SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
        SetPlayerProperty(1, 0, PROP_FROZEN);
		ACS_Execute(2,0,0,0,0);
}

