#include"Zcommon.acs"

script 80 ENTER
{
	SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.25);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	Thing_ChangeTID (0, 1337+PlayerNumber());
	fadeto(0, 0, 0, 1.0, 0.0);
	ChangeSky("CMP_DSRT", "CMP_DSRT");
	DELAY(40);
	SetMusic("CPN_LDOT", 0);
	fadeto(0, 0, 0, 0, 1.0);
	if (CheckInventory("mission_confirmation") == 1)
	{
		GiveActorInventory(1337, "AK-12", 999);
		GiveActorInventory(1337, "ColtM1911", 999);
		GiveActorInventory(1337, "Knife", 1);
		GiveActorInventory(1337, "FragGrenade", 4);
	}
}

script 14 (void)//PLAYERS CURSOR MOVE LIMIT//
{

    SetPlayerProperty(1, 1, PROP_FROZEN);
    
    while (True)
    {
        If(GetActorAngle(1337)>0.5 && GetActorAngle(1337)<0.8)
        {
            SetActorAngle(1337,0.5);
        }
        Else If(GetActorAngle(1337)<0.9999 && GetActorAngle(1337)>0.8)
        {
            SetActorAngle(1337,0.0);
        }
        Delay (1);
    }
}

//////////////
//LOAD-OUT///
////////////

Script 13 (void) //Exit Load-Out Menu//
{
	ACS_Terminate(14,0);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	TakeInventory("Cursor" ,255);
	Thing_Move(1337, 1, 1);
	ChangeCamera(0,0,0); 
	SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.25);
}

Script 12 (void) //Exit PowerGums Menu//
{
	ACS_Terminate(14,0);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	TakeInventory("Cursor" ,255);
	Thing_Move(1337, 22, 1);
	ChangeCamera(0,0,0); 
	SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.5);
}

Script 15 (void) //Initiate Load-Out Menu//
{
	Thing_move(1337, 10, 1);
	ACS_Execute(14,0,0,0,0);
	ACS_Terminate(1,0);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 1, PROP_FROZEN);
	ACS_Execute(14,0,0,0,0);
	ChangeCamera(3, 1, 0);
	SetActorPitch(1337, 0);
	SetActorAngle(1337, 0.25);
	GiveInventory("Cursor", 1);
	SetWeapon("Cursor");
	SetMusic("CPN_LDOT", 0);
}

script 16 (void) //Main Load-Out Menu//
{
	AmbientSound("sound/SELECT", 127);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	SetPlayerProperty(1, 1, PROP_TOTALLYFROZEN);
	changecamera(3, 1, 0);
	delay(3);
	Thing_move(1337, 10, 1);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 1, PROP_FROZEN);
}

