Script 2 (void)//Select the next mission
{
	if (CheckInventory("mission_confirmation") == 1)
	{
		ChangeLevel("Map06", 0, CHANGELEVEL_NOINTERMISSION, -1);//Chapter 2 Mission 1
	}
	else if (CheckInventory("mission_confirmation") == 2)
	{
		ChangeLevel("Map07", 0, CHANGELEVEL_NOINTERMISSION, -1);//Chapter 2 Mission 2
	}
	else if (CheckInventory("mission_confirmation") == 3)
	{
		ChangeLevel("Map08", 0, CHANGELEVEL_NOINTERMISSION, -1);//Chapter 2 Mission 3
	}
}

Script 3 (void)//Save your game 

{
	HudMessage(s:"\cuPress \ck", k:"+use", s:" \cu to Save Progress";
	HUDMSG_FADEINOUT, 6, CR_White, 3.0, 0.7, 5.0);
}

Script 4 (void)

{
	HudMessage(s:"Saving..";
	HUDMSG_FADEINOUT, 6, CR_White, 3.0, 0.7, 5.0);
	delay(4);
	Autosave();
	delay(1);
	HudMessage(s:"Game Saved!";
	HUDMSG_FADEOUT, 6, CR_White, 3.0, 0.7, 3.0);
}
