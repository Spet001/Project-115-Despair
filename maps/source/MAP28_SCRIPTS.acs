TakeInventory("CP_LightsOn", 255);
TakeInventory("CP_ConcealedFighter", 255);
TakeInventory("CP_WalkingTank", 255);
TakeInventory("CP_Vampirism", 255);
TakeInventory("CP_LimitlessClip", 255);
hudmessage(s:"Out Of Sight Selected";
HUDMSG_FADEINOUT, 3, CR_White, 3.0, 0.6, 3.1);
}
	else if(CheckWeapon("Cursor_Info"))
	{
		HudMessage(s:"[Out of Sight]\nActivation: 2x Player Activated\nDuration: 20 Seconds Each\nEffect: All Enemies Run Away From You";
		HUDMSG_FADEINOUT, 103, CR_WHITE, 3.0, 0.9, 10.6);
	}
}
