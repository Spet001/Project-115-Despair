    		hudmessage(s:"[Jason]\n\cjHe wasn't. Funny how he asked me the same thing.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q8", 127);
        delay(135);
    		hudmessage(s:"[Jason]\n\cjI told him that I was hiding from the Red Division. Turns out that he was too.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q9", 127);
        delay(160);
		hudmessage(s:"[Jason]\n\cjI showed him the necklace. He was shocked to see a key to enter Ogrodolon.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q10", 127);
	GiveInventory("Gateway_Necklace_Portal",1);
	SetWeapon("Gateway_Necklace_Portal");
        delay(150);
    		hudmessage(s:"[Savion]\n\cjWhat's...Ogrodolon?";
