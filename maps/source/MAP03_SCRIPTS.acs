script 64 (void)

{
	Acs_Terminate(300,0);
	delay(2);
	GiveInventory("CP_MaxAmmo", 1);
	SetPlayerProperty(1, off, PROP_TOTALLYFROZEN);
	Thing_Move(1337, 66, 1);
		Thing_Activate(1);
		SetActorState(1, "See", TRUE);
	Thing_SetGoal (1, 67, 0, 1);
	delay(10);
	Autosave();
	hudmessage(s:"[Jason]\n\cjHis name is Danny Kain. Former member of the Walking Flesh Organization.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q14", 127);
        delay(180);
	hudmessage(s:"[Jason]\n\cjWith the formation of the Red Division, they wanted marksmen like him.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q15", 127);
        delay(140);
	hudmessage(s:"[Jason]\n\cjSkillful in killing anyone that is running.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q16", 127);
        delay(140);
	hudmessage(s:"[Jason]\n\cjHe never told how he broke free from The Source's control. His only objective was to destroy The Source.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C1M2Q17", 127);
        delay(200);
	hudmessage(s:"[Savion]\n\cjDid you ally with Danny?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q18", 127);
        delay(100);
	hudmessage(s:"[Jason]\n\cjWhat other choice did I have? It was either escape with Danny or The Red Division would kill me.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q19", 127);
	delay(130);
	SetLineBlocking(2, BLOCK_NOTHING);
}

