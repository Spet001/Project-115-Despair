script 67 (void)//Whether or not the player get's to play as the Stranger

{
	GiveInventory("CP_MaxAmmo", 1);
    If(ChecKInventory("Quest_Danny_Kain_IsHurt") == 1)
	{
		SetPlayerProperty(1, On, PROP_TOTALLYFROZEN);
		ACS_Execute(68,0,0,0,0);
	}
	    else If(ChecKInventory("Quest_Danny_Kain_IsNotHurt") == 1)
	{
		SetPlayerProperty(1, On, PROP_TOTALLYFROZEN);
		ACS_Execute(69,0,0,0,0);
	}
	
}

script 68 (void)//If the Stranger was hurt by the player
{
    fadeto(0,0,0,1.0, 1.0);
    delay(60);
    Thing_Move(1337, 127, 1);
	Thing_Move(1, 128, 1);
	SetActorAngle(1, 0.5);
	Thing_Deactivate(1);
	SetActorAngle(1337, 1.0);
    delay(10);
    fadeto(0,0,0,0, 1.0);
	delay(10);
	hudmessage(s:"[Jason]\n\cjWe entered a library. Danny came through the back. But we had company.";
	HUDMSG_FADEINOUT, 100, CR_GREEN, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q21", 127);
	DELAY(160);
	AmbientSound("zombie/running", 60);
	delay(15);
	AmbientSound("zombie/running", 40);
	SetActorAngle(1, 1.0);
	delay(15);
	AmbientSound("zombie/running", 70);
	delay(15);
	AmbientSound("zombie/running", 50);
	delay(15);
	AmbientSound("zombie/running", 60);
	delay(10);
hudmessage(s:"[Jason]\n\cjzombies where coming from the back as well.";
	HUDMSG_FADEINOUT, 100, CR_GREEN, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q22", 127);
	delay(130);
	SetActorAngle(1, 0.5);
	hudmessage(s:"[Savion]\n\cjWhat about the Red Division?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q23", 127);
	delay(100);
hudmessage(s:"[Jason]\n\cjThey were here too. We could have escaped, but it would be better to have a clear escape due to Danny's pain.";
	HUDMSG_FADEINOUT, 100, CR_GREEN, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q24", 127);
	Delay(160);
	fadeto(0,0,0,1.0, 1.0);
    delay(60);
    Thing_Move(1337, 127, 1);
	Thing_Move(1, 129, 1);
	Thing_Activate(1);
    delay(10);
    fadeto(0,0,0,0, 1.0);
	delay(10);
	Autosave();
	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
	SetActorAngle(1337, 0.5);
	ACS_Execute(70,0,0,0,0);
	Autosave();
	DELAY(100);
	ACS_Execute(71,0,0,0,0);
}

