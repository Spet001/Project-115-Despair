Script 12 (void)
{
	 int buttons;

 while (TRUE)
 {
   buttons = GetPlayerInput(-1, INPUT_BUTTONS);

   if (buttons & BT_USE)
   {
	   SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
	   Delay(1);
	 		for(int j=0; j<=999; j++)
	Sector_SetColor(j,255,255,255,100);
	 delay(1);
	 SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
	 ThrustThing(128, 5, 0, 1337);
	 ACS_Terminate(11,0);
	 ACS_Terminate(90,0);
	 delay(4);
	 AmbientSound("weapons/SLASH", 127);
	 Thing_Remove(52);
	 SpawnSpotFacingForced("Danny_Kain_Injured_Kick", 51, 52);
	 ThrustThing(128, 5, 0, 52);
	 delay(1);
	 ACS_Execute(13,0,0,0,0);
   }

   delay(1);
 }
}

