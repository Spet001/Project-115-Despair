Script 8 (void)
{

	SetLineBlocking(42, BLOCK_PLAYERS);
	SetPlayerProperty(1, OFF, PROP_TOTALLYFROZEN);
	SetActorProperty(1337, APROP_Invulnerable, On);
    Acs_Terminate(7,0);
	delay(4);
	TakeInventory("Fall", 999);
	delay(60);
	SetActorProperty(1337, APROP_Invulnerable, OFF);
	Autosave();
	delay(20);
	hudmessage(s:"[Jason]\n\cjI lost grip of the edge. Luckily there was another way around.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q2", 127);
	delay(130);
	hudmessage(s:"[Jason]\n\cjAt that point, I knew I was not the only one in there.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 6.0);
	AmbientSound("quote/C1M2Q4", 127);
}

script 9 (void)

{
		if(climb <= 9)
		{
			Radius_Quake(4, 2, 0, 3, 0);
			climb ++;
		}
		else if(climb == 10)
        {
    Acs_Terminate(6,0);
    Acs_Terminate(7,0);
	Acs_Terminate(90,0);
        THing_Remove(40);
        Acs_execute(10,0,0,0,0);
      ThrustThingZ(1337, 50, 0 ,0);
	  TakeInventory("Fall", 999);
	  SetLineBlocking(42, BLOCK_NOTHING);
    delay(10);
    ThrustThing(128, 10, 0 ,1337);
	Delay(10);
	SetLineBlocking(42, BLOCK_PLAYERS);
	Delay(20);
	Autosave();
	hudmessage(s:"[Jason]\n\cjI almost lost grip of the edge.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q3", 127);
    delay(130);
	hudmessage(s:"[Jason]\n\cjAt that point, I knew I was not the only one in there.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 6.0);
	AmbientSound("quote/C1M2Q4", 127);
}
}

