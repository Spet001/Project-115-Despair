script 70 (void)//Start The Red Division Zombie Spawn

{
	SpawnSpotForced("CP_NormalZombie1", Random(139, 140), 30, 64);
	delay(Random(40, 50));
	SpawnSpotForced("AssaultScavenger", Random(141, 143), 30, 64);
	delay(Random(40, 50));
	SpawnSpotForced("CP_NormalZombie2", Random(139, 140), 30, 64);
	delay(Random(40, 50));
