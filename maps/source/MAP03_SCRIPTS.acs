script 71 (void)

{
	While(TRUE)
	{
			If (ThingCountName("CP_NormalZombie1", 30) == 0 && ThingCountName("CP_NormalZombie2", 30) == 0 && 
	ThingCountName("AssaultScavenger", 30) == 0 && ThingCountName("RangerScavenger", 30) == 0 && 
	ThingCountName("FastZombie1", 30) == 0 && ThingCountName("FastZombie2", 30) == 0 && 
	ThingCountName("EliteScavenger", 30) == 0)
	{
	delay(3);
	hudmessage(s:"[Jason]\n\cjThe area was secure. We were safe to leave.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q26", 127);
	delay(160);
	ACS_Execute(72,0,0,0,0);
}
delay(1);
}
}

//Finishing The Level

SCRIPT 72 (void)
{
	TakeActorInventory(1337, "HUD_ON", 1);
ACS_Terminate(71,0);
	ACS_Terminate(23,0);
	Thing_Deactivate(102);
	SetMusic("CMC_MUS", 0);
	SetPlayerProperty(1, ON, PROP_TOTALLYFROZEN);
	fadeto(0, 0, 0, 1.0, 3.0);
	delay(200);
	changecamera(27, 1, 0);
	Thing_Activate(27);
	delay(10);
	fadeto(0, 0, 0, 0,3.0);
	delay(100);
	ACS_Execute(73,0,0,0,0);
			hudmessage(s:"Press '", k:"+attack", s:"' to Skip";
	HUDMSG_FADEINOUT, 101, CR_White, 2, 0.9, 999.999);
	hudmessage(s:"[Jason]\n\cjI had a strange feeling in my gut. I didn't know if I could trust him. I just met the guy.";
	HUDMSG_FADEINOUT, 100, CR_GREEN, 3.0, 0.7, 4.3);
	AmbientSound("quote/C1M2Q27", 127);
	delay(200);
	hudmessage(s:"[Savion]\n\cjAnd you still believed him?";
	HUDMSG_FADEINOUT, 100, CR_GREEN, 3.0, 0.7, 3.0);
	AmbientSound("quote/C1M2Q28", 127);
		changecamera(26, 1, 0);
	Thing_Activate(26);
	delay(100);
	hudmessage(s:"[Jason]\n\cjI did anyway. If I never encounted him, I wouldn't be here right now.";
	HUDMSG_FADEINOUT, 100, CR_GREEN, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M2Q29", 127);
	delay(140);
	fadeto(255, 255, 255, 1.0, 2.0);
	GiveActorInventory(1337, "Mission_Confirmation", 1);
	delay(150);
	ChangeLevel("map27", 0, CHANGELEVEL_NOINTERMISSION, -1);
}

script 73 (void)
{
 int buttons;

 while (TRUE)
 {
   buttons = GetPlayerInput(-1, INPUT_BUTTONS);

   if (buttons & BT_ATTACK)
   {
	hudmessage(s:"";
	HUDMSG_FADEINOUT, 101, CR_White, 2, 0.9, 999.999);
	   ACS_Terminate(72,0);
	fadeto(255, 255, 255, 1.0, 2.0);
	GiveInventory("Mission_Confirmation", 1);
	delay(150);
	ChangeLevel("map27", 0, CHANGELEVEL_NOINTERMISSION, -1);
   }

   delay(1);
 }
}
