Script 50 (void)
{
	SetFont("DIETLOGFONT");
	HudMessage(s:"\ciProject 115 - Despair\n\cjCredits";
	HUDMSG_PLAIN, 200, CR_WHITE, 3.0, Scrollup, 0.1);
	ScrollUp -= 0.001;
	if (ScrollUp <= 0.1)
	{
	HudMessage(s:"";
	HUDMSG_PLAIN, 200, CR_WHITE, 3.0, Scrollup, 0.1);
	}
