#include"zcommon.acs"

int Count = 0;
bool campaign;

script 996 (void)//PLAYERS CURSOR MOVE LIMIT//
{

    SetPlayerProperty(1, 1, PROP_FROZEN);
    
    while (True)
    {
        If(GetActorAngle(1337)>0.5 && GetActorAngle(1337)<0.8)
        {
            SetActorAngle(1337,0.5);
        }
        Else If(GetActorAngle(1337)<0.9999 && GetActorAngle(1337)>0.8)
        {
            SetActorAngle(1337,0.0);
        }
        Delay (1);
    }
}
Script 995 Enter
{
	ThingSound(10, "zombie/idle", 70);
	delay(random(60, 160));
	restart;
}

Script 997 Enter
{
	ThingSound(14, "sound/ARCFIRE", 10);
	delay(random(2, 30));
	ThingSound(14, "sound/ARCDEAD", 10);
	delay(random(4, 40));
	restart;
}

script 993 enter
{
Scroll_Texture_Both(1, 0, 96, 0, 0);
}

script 994 enter

{
TakeInventory("HUD_ON", 1);
        SetFont("DIETLOGFONT");
hudmessage(s:"V4.0";
HUDMSG_PLAIN, 90, CR_WHITE, 0, 0.96, 0);
HudMessageBold(s:"(4 Players Max)";
HUDMSG_PLAIN, 0, CR_WHITE, 2.0, 0.0, 0);
sector_setfade(16, 20, 10, 0);
}

script 1 enter
{
//SETUP
//Make Sure that the player does not have any inventory from campaign, survival, or arcade mode//
	{
	if (PlayerNumber() > 1)
		{
		ChangeCamera(48, 0, 1);
ClearInventory();
	hudmessage(s:"Please Wait For The Host To Choose Game Mode";
HUDMSG_PLAIN, 0, CR_WHITE, 3.0, 0.7, 0);
		}
			if (PlayerNumber() == 0)
		{
ClearInventory();
changecamera(7, 1, 0);
fadeto(0, 0, 0, 10.3, 0);
ACS_Execute(996,0,0,0,0);
Scroll_Ceiling(1, 0, 5, 0);
   Thing_ChangeTID (0, 1337+PlayerNumber());
   SetPlayerProperty(1, 1, PROP_TOTALLYFROZEN);
        delay(1);
		TakeInventory("Pistol", 999);
		TakeInventory("FIST", 999);
		GiveInventory("Cursor", 999);
setmusic("MAINMUS", 0, 0);
	DELAY(100);
	fadeto(0, 0, 0, 0, 4.0);
	delay(120);
	 SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 1, PROP_FROZEN);
       SetFont("DIETLOGFONT");
        HUDMessage(k:"+attack",s:" To Start";
                HUDMSG_FADEINOUT,11,CR_ORANGE,0.5,0.97,99999999);
}
}
}

script 2 (void)
{
	SetFont("DIETLOGFONT");
	        HUDMessage(s:"Loading...";
                HUDMSG_FADEOUT,11,CR_ORANGE,0.5,0.97,1.1);
	FadeTo(0,0,0,1.0,0);
	delay(1);
	changecamera(4, 1, 0);
	FadeTo(0,0,0,0,2.0);
	Thing_move(1337, 9, 1);
	delay(50);
		SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 1, PROP_FROZEN);
}


