Script 14 (void) //Starts Chapter 1

{
			if (PlayerCount() >= 2) 
		{
	hudmessage(s:"Can Not Continue. Campaign Is Not Available For Multiplayer";
HUDMSG_FADEINOUT, 100, CR_WHITE, 3.0, 0.7, 2.0);
		}
		else if (PlayerCount() == 1)
		{
			SetFont("DIETLOGFONT");
			ACS_Execute(109,0,0,0,0);
	TranslucentLine (25, 0, 0);
	AmbientSound("sound/SELECT", 127);
	FadeTo(0,0,0,1.0,4.0);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	SetPlayerProperty(1, 1, PROP_TOTALLYFROZEN);
	delay(200);
	changecamera(1, 1, 0);
	Thing_Activate(1);
	delay(4);
	FadeTo(0,0,0,0,4.0);
	SetMusic("SHACK_MU", 0);
	HudMessage(s:"[Jason]\n\cjHello Savion. It's been a while.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/PSTQ1", 127);
	delay(110);
	FadeTo(0,0,0,1.0,2.0);
	Delay(110);
	FadeTo(0,0,0,0.0,2.0);
	changecamera(11, 1, 0);
	Thing_Activate(11);
	HudMessage(s:"[Savion]\n\cjGlad to see you Jason. My mechanical voice box isn't functioning properly. I apologize for my odd voice.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 5.4);
	AmbientSound("quote/PSTQ2", 127);
	Delay(265);
	HudMessage(s:"[Jason]\n\cjI understand. Unfortunate that you've only seen me as a person a few times when you were younger. When you were with my sister.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 6.3);
	AmbientSound("quote/PSTQ3", 127);
	Delay(275);
	changecamera(33, 1, 0);
	Thing_Activate(33);
	HudMessage(s:"[Savion]\n\cjI remember Iris taking care of me. She was like a mother. What happened to her?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.4);
	AmbientSound("quote/PSTQ4", 127);
	Delay(210);
	changecamera(36, 1, 0);
	Thing_Activate(36);
	HudMessage(s:"[Jason]\n\cjIt's been..tough..not being able to see Iris. Witnessing her last stand against the hoard was...tragic.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 7.0);
	AmbientSound("quote/PSTQ5", 127);
	Delay(280);
	HudMessage(s:"[Savion]\n\cjI'm sorry to hear that..";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 2.8);
	AmbientSound("quote/PSTQ6", 127);
	changecamera(39, 1, 0);
	Thing_Activate(39);
	Delay(90);
	HudMessage(s:"[Jason]\n\cjSurprised that the fact I'm still alive.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/PSTQ7", 127);
	changecamera(42, 1, 0);
	Thing_Activate(42);
	Delay(150);
	HudMessage(s:"[Jason]\n\cjNow I sit here in a jar of what's left of me.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/PSTQ8", 127);
	Delay(150);
	HudMessage(s:"[Jason]\n\cjEverything I have experienced.. Gun fights, zombies, the Red Division..The wretched Source.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 6.6);
	AmbientSound("quote/PSTQ9", 127);
	Delay(260);
	HudMessage(s:"[Jason]\n\cjSo many survivors of the Cannibalism Strike left in despair. I was one of them.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.5);
	AmbientSound("quote/PSTQ10", 127);
	Delay(220);
	HudMessage(s:"[Savion]\n\cjHow did you end up in there?";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/PSTQ11", 127);
	changecamera(33, 1, 0);
	Thing_Activate(33);
	Delay(120);
	HudMessage(s:"[Jason]\n\cjCurious to hear how I got here? Sit back and relax.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 3.0);
	AmbientSound("quote/PSTQ12", 127);
		changecamera(45, 1, 0);
	Thing_Activate(45);
	DELAY(70);
	FadeTo(0,0,0,1.0,3.0);
	DELAY(120);
	TakeActorInventory(1337, "Cursor", 999);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	ChangeLevel("MAP02", 0, CHANGELEVEL_NOINTERMISSION, -1);
}
}

Script 32 (void) //Starts Chapter 2

{
			if (PlayerCount() >= 2) 
		{
	hudmessage(s:"Can Not Continue. Campaign Is Not Available For Multiplayer";
HUDMSG_FADEINOUT, 100, CR_WHITE, 3.0, 0.7, 2.0);
		}
		else if (PlayerCount() == 1)
		{
			SetFont("DIETLOGFONT");
			ACS_Execute(109,0,0,0,0);
	AmbientSound("sound/SELECT", 127);
	FadeTo(0,0,0,1.0,4.0);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	SetPlayerProperty(1, 1, PROP_TOTALLYFROZEN);
	delay(200);
	changecamera(1, 1, 0);
	Thing_Activate(1);
	Delay(10);
	SetMusic("SHACK_MU", 0);
	HudMessage(s:"Previously on Despair";
	HUDMSG_FADEINOUT, 100, CR_Orange, 3.0, 0.7, 3.0);
	Delay(120);
	FadeTo(255,255,255,1.0,1.5);
	delay(30);
	SetLineTexture(18, SIDE_FRONT, TEXTURE_MIDDLE, "PREVCOM1");
	FadeTo(0,0,0,0,1.5);
	hudmessage(s:"[Jason]\n\cjI didn't know why they were after me for this necklace. From my eyes, it looked very valuable.";
	HUDMSG_FADEINOUT, 0, CR_Green, 3.0, 0.7, 5.0);
	AmbientSound("quote/C1M1Q7", 127);
	changecamera(19, 1, 0);
	Delay(200);
	FadeTo(255,255,255,1.0,1.5);
	delay(30);
	SetLineTexture(18, SIDE_FRONT, TEXTURE_MIDDLE, "PREVCOM2");
	FadeTo(0,0,0,0,1.5);
	hudmessage(s:"[Jason]\n\cjI had a strange feeling in my gut. I didn't know if I could trust him. I just met the guy.";
	HUDMSG_FADEINOUT, 100, CR_GREEN, 3.0, 0.7, 4.3);
	AmbientSound("quote/C1M2Q27", 127);
	Delay(200);
	FadeTo(255,255,255,1.0,1.5);
	delay(30);
	SetLineTexture(18, SIDE_FRONT, TEXTURE_MIDDLE, "PREVCOM3");
	FadeTo(0,0,0,0,1.5);
	hudmessage(s:"[Jason]\n\cjThere was tram that lead us further underground. The further we went the more the necklace was glowing.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 7.0);
	AmbientSound("quote/C1M3Q11", 127);
	Delay(100);
	FadeTo(255,255,255,1.0,1.5);
	delay(30);
	SetLineTexture(18, SIDE_FRONT, TEXTURE_MIDDLE, "PREVCOM4");
	FadeTo(0,0,0,0,1.5);
	Delay(100);
	FadeTo(255,255,255,1.0,1.5);
	delay(30);
	FadeTo(0,0,0,0,1.5);
	SetLineTexture(18, SIDE_FRONT, TEXTURE_MIDDLE, "PREVCOM5");
	hudmessage(s:"[Jason]\n\cjThe Inferno Seeker was defeated. We entered the portal. Ogrodolan looked to be empty.";
	HUDMSG_FADEINOUT, 100, CR_Green, 3.0, 0.7, 4.0);
	AmbientSound("quote/C1M4Q8", 127);
	DELAY(70);
	GiveActorInventory(1337, "Mission_Confirmation", 1);
	FadeTo(0,0,0,1.0,3.0);
	DELAY(120);
	TakeActorInventory(1337, "Cursor", 999);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	ChangeLevel("MAP28", 0, CHANGELEVEL_NOINTERMISSION, -1);
}
}

