		script 109 (void)
{
	While(true)
	{
		if (PlayerCount() >= 2) 
		{
			FadeTo(0,0,0,0,1.0);
	setmusic("MAINMUS", 0, 0);
	SetFont("DIETLOGFONT");
	HUDMessage(s:"Error: Can Not Continue Campaign\n 'PlayerCount()' Found More Than 1 Player In The Game";
	HUDMSG_FADEOUT,100,CR_ORANGE,3.0,0.70,4.0);
	ACS_Terminate(14,0);
	ACS_Terminate(32,0);
	delay(1);
	changecamera(4, 1, 0);
	FadeTo(0,0,0,0,2.0);
	Thing_move(1337, 9, 1);
	delay(50);
	FadeTo(0,0,0,0,1.0);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 1, PROP_FROZEN);
	delay(10);
	ACS_Terminate(109,0);
	}
	delay(1);
}
}

script 110 (void)
{
 int buttons;

 while (TRUE)
 {
   buttons = GetPlayerInput(-1, INPUT_BUTTONS);

   if (buttons & BT_ATTACK)
   {
	hudmessage(s:"";
	HUDMSG_FADEINOUT, 101, CR_White, 2, 0.9, 999.999);
	AmbientSound("sound/SELECT", 127);
	ACS_Terminate(31,0);
	SetMusic("BOTKIL8");
	FadeTo(0,0,0,1.0,0.1);
	Delay(20);
	TakeActorInventory(1337, "Cursor", 999);
	SetPlayerProperty(1, 0, PROP_TOTALLYFROZEN);
	SetPlayerProperty(1, 0, PROP_FROZEN);
	ChangeLevel("MAP16", 0, CHANGELEVEL_NOINTERMISSION, -1);
   }

   delay(1);
 }
}
