	AmbientSound("quote/C2M3Q3", 127);
	Delay(240);
	FadeTo(255,255,255,1.0,1.5);
	delay(30);
	SetLineTexture(18, SIDE_FRONT, TEXTURE_MIDDLE, "PREVCOM9");
	FadeTo(0,0,0,0,1.5);
	hudmessage(s:"[Danny]\n\cjI'm sorry, but there has been a change of plans.";
	HUDMSG_FADEINOUT, 100, CR_RED, 3.0, 0.7, 5.0);
	AmbientSound("quote/C2M3Q7", 127);
	Delay(200);
	FadeTo(255,255,255,1.0,1.5);
	delay(30);
	FadeTo(0,0,0,0,1.5);
	SetLineTexture(18, SIDE_FRONT, TEXTURE_MIDDLE, "PREVCOM");
