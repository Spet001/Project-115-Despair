Script 501 enter
{
	while(true)
	{
	if (PlayerNumber() > 0)
		{
			SetFont("DIETLOGFONT");
		ChangeCamera(48, 0, 1);
ClearInventory();
	hudmessage(s:"Please Wait For The Host To Choose Game Mode";
HUDMSG_PLAIN, 0, CR_WHITE, 3.0, 0.7, 0);

		}
				delay(1);
	}
}

Script 502 (void)
{
	While(True)
	{
	if (PlayerCount() >= 2)
		{
	Acs_terminate(14,0);
	ACS_Execute(2,0,0,0,0);
	delay(1);
Acs_terminate(502,0);
}
delay(1);
}
}

//CHECK FOR PLAYERS IN YOUR SERVER
    script 100 ENTER
    
